<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'nf-fonts.css' | asset_url | stylesheet_tag }}
    {{ 'nf-base.css' | asset_url | stylesheet_tag }}
    {% render 'nf-theme-tokens' %}
  </head>
  <body class="nf nf-password">
    <main class="nf-password__main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
