{%- liquid
  assign slide_count = section.blocks.size
  assign cta_url = section.settings.cta_url | default: routes.all_products_collection_url
  assign cta2_url = section.settings.cta2_url
  assign scroll_length = section.settings.scroll_length | default: 180
-%}
<section
  class="nf-hero"
  id="{{ section.settings.anchor_id | default: 'top' | handle }}"
  data-nf-hero
  data-autoplay-interval="{{ section.settings.autoplay_interval | default: 5 }}"
  data-loader-duration="{{ section.settings.loader_duration | default: 5.6 }}"
  data-loader-enabled="{% if section.settings.loader_enabled %}true{% else %}false{% endif %}"
  data-scroll-length="{{ scroll_length }}"
>
  <h1 class="nf-visually-hidden">{{ section.settings.seo_heading | default: shop.name }}</h1>

  <div class="nf-hero__track" data-nf-hero-track>
    <div class="nf-hero__stage" data-nf-hero-stage>
      {%- comment -%}
        Grow spacer = final window hole (no position:relative).
        Absolute media layer lives inside it so inset-0 resolves to the sticky stage.
      {%- endcomment -%}
      <div class="nf-hero__media-frame" data-nf-hero-frame>
        <div class="nf-hero__media-layer" data-nf-hero-media>
          <div class="nf-hero__slides" data-nf-hero-slides>
            {%- if slide_count > 0 -%}
              {%- for block in section.blocks -%}
                <div
                  class="nf-hero__slide{% if forloop.first %} is-active{% endif %}"
                  data-nf-hero-slide
                  data-index="{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >
                  {%- render 'nf-media',
                    video: block.settings.video,
                    video_url: block.settings.video_url,
                    image: block.settings.image,
                    asset: block.settings.asset,
                    alt: block.settings.label,
                    class: 'nf-hero__media',
                    sizes: '100vw',
                    loading: 'eager'
                  -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="nf-hero__slide is-active" data-nf-hero-slide data-index="0">
                {%- render 'nf-media', asset: 'nf-lifestyle-hero-01.jpg', class: 'nf-hero__media', loading: 'eager' -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="nf-hero__copy" data-nf-hero-copy>
        <div class="nf-hero__copy-grid">
          <div class="nf-hero__copy-main">
            {%- if section.settings.hero_eyebrow != blank -%}
              <p class="nf-eyebrow nf-hero__eyebrow" data-nf-hero-eyebrow>{{ section.settings.hero_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.hero_heading != blank -%}
              <h2 class="nf-hero__heading" data-nf-hero-heading>{{ section.settings.hero_heading | escape }}</h2>
            {%- endif -%}
          </div>
          <div class="nf-hero__copy-side" data-nf-hero-copy-side>
            {%- if section.settings.hero_subheading != blank -%}
              <p class="nf-hero__sub">{{ section.settings.hero_subheading | escape }}</p>
            {%- endif -%}
            <div class="nf-hero__ctas" data-nf-hero-ctas>
              {%- if section.settings.cta_label != blank -%}
                <a class="nf-btn nf-btn--accent nf-btn--pill" href="{{ cta_url }}">
                  {{- section.settings.cta_label | escape -}}
                </a>
              {%- endif -%}
              {%- if section.settings.cta2_label != blank and cta2_url != blank -%}
                <a class="nf-btn nf-btn--circle" href="{{ cta2_url }}" aria-label="{{ section.settings.cta2_label | escape }}">
                  <span aria-hidden="true">→</span>
                </a>
              {%- elsif section.settings.cta_label != blank -%}
                <a class="nf-btn nf-btn--circle" href="{{ cta_url }}" aria-label="{{ section.settings.cta_label | escape }}">
                  <span aria-hidden="true">→</span>
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>

        {%- if slide_count > 1 -%}
          <div class="nf-hero__dots" data-nf-hero-dots role="tablist" aria-label="Hero slides">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="nf-hero__dot{% if forloop.first %} is-active{% endif %}"
                data-nf-hero-dot
                data-index="{{ forloop.index0 }}"
                aria-label="{{ block.settings.label | default: forloop.index | escape }}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.loader_enabled -%}
    <div class="nf-preloader" data-nf-preloader aria-hidden="true">
      <div class="nf-preloader__logo" data-nf-preloader-logo>
        <div class="nf-preloader__water" data-nf-preloader-water></div>
        <img
          class="nf-preloader__mark nf-preloader__mark--desktop"
          src="{{ 'Fizz_Logo_Intro.svg' | asset_url }}"
          alt=""
          width="640"
          height="398"
          decoding="async"
        >
        <img
          class="nf-preloader__mark nf-preloader__mark--mobile"
          src="{{ 'Fizz_Logo_INTRO_SVG_Mobile.svg' | asset_url }}"
          alt=""
          width="320"
          height="749"
          decoding="async"
        >
      </div>
      <p class="nf-preloader__status" data-nf-preloader-status>
        <span>loading...</span>
        <span data-nf-preloader-pct>0%</span>
      </p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "NF Hero",
  "tag": "section",
  "class": "nf-hero-section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "seo_heading",
      "label": "Accessible page heading"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "top"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Fast, secure and portable"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading",
      "default": "Sparkling water, anywhere."
    },
    {
      "type": "textarea",
      "id": "hero_subheading",
      "label": "Subheading",
      "default": "Fill. Twist. Fizz. Cold bubbles in under ten seconds — no machine, no cans."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button",
      "default": "Shop bottles"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Arrow button label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Arrow button link"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Scroll window"
    },
    {
      "type": "range",
      "id": "scroll_length",
      "label": "Scroll distance to inset",
      "info": "How far the visitor scrolls while the media clips from full-bleed into the rounded window.",
      "min": 80,
      "max": 200,
      "step": 10,
      "unit": "vh",
      "default": 180
    },
    {
      "type": "header",
      "content": "Intro loader"
    },
    {
      "type": "checkbox",
      "id": "loader_enabled",
      "label": "Enable water-fill logo loader",
      "default": true
    },
    {
      "type": "range",
      "id": "loader_duration",
      "label": "Loader duration",
      "min": 2,
      "max": 8,
      "step": 0.2,
      "unit": "s",
      "default": 5.6,
      "info": "Slower fills read more like water rising behind the logo, then zoom into the hero."
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Lifestyle"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "External video",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Theme asset fallback",
          "default": "nf-lifestyle-hero-01.jpg"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "NF Hero",
      "blocks": [
        { "type": "media", "settings": { "label": "On the go", "asset": "nf-lifestyle-hero-01.jpg" } },
        { "type": "media", "settings": { "label": "Drive", "asset": "nf-lifestyle-hero-02.jpg" } },
        { "type": "media", "settings": { "label": "Active", "asset": "nf-lifestyle-hero-03.jpg" } },
        { "type": "media", "settings": { "label": "Field", "asset": "nf-lifestyle-hero-04.jpg" } },
        { "type": "media", "settings": { "label": "Court", "asset": "nf-lifestyle-hero-05.jpg" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
