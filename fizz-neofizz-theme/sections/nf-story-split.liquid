{%- liquid
  assign cta_url = section.settings.cta_url | default: routes.root_url
-%}
<section
  class="nf-story"
  id="{{ section.settings.anchor_id | default: 'about' | handle }}"
  data-nf-story
  data-nf-reveal
>
  <div class="nf-container nf-story__grid">
    <div class="nf-story__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nf-eyebrow nf-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="nf-heading nf-story__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="nf-rte nf-story__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="nf-btn nf-btn--ghost" href="{{ cta_url }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="nf-story__media" data-nf-parallax>
      <div class="nf-story__media-frame">
        {%- render 'nf-media',
          video: section.settings.video,
          image: section.settings.image,
          asset: section.settings.asset,
          alt: section.settings.heading,
          class: 'nf-story__img',
          sizes: '(min-width: 750px) 48vw, 100vw'
        -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NF Story Split",
  "tag": "section",
  "class": "nf-story-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Technology"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bubbles without the baggage"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>We started Fizz because sparkling water should not need a truck, a fridge, or a mountain of cans. One bottle, one pod, endless sparkle.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "text",
      "id": "asset",
      "label": "Theme asset fallback",
      "default": "nf-lifestyle-story-01.jpg"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "about"
    }
  ],
  "presets": [{ "name": "NF Story Split" }]
}
{% endschema %}
