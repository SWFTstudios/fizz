{%- liquid
  assign glass_blur = section.settings.glass_blur | default: 20
  assign glass_opacity_pct = section.settings.glass_opacity | default: 28
  assign glass_opacity = glass_opacity_pct | times: 1.0 | divided_by: 100.0
  assign glass_tint = section.settings.glass_tint | default: '#0a3d3f'
  assign glass_tint_a = glass_tint | color_modify: 'alpha', glass_opacity
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign text_rgb = text_color | color_to_rgb | remove: 'rgb(' | remove: ')'
  assign min_height = section.settings.min_height | default: 480
  assign glass_padding = section.settings.glass_padding | default: 40
  assign content_max = section.settings.content_max_width | default: 1100
  assign overlay_pct = section.settings.overlay_opacity | default: 20
  assign overlay_a = overlay_pct | times: 1.0 | divided_by: 100.0
  assign inset = section.settings.glass_inset | default: 24
-%}
<div
  class="nf-footer-2"
  id="footer-2"
  style="
    --nf-ft2-min-height: {{ min_height }}px;
    --nf-ft2-glass-bg: {{ glass_tint_a }};
    --nf-ft2-glass-blur: blur({{ glass_blur }}px);
    --nf-ft2-text: {{ text_color }};
    --nf-ft2-text-rgb: {{ text_rgb }};
    --nf-ft2-glass-pad: {{ glass_padding }}px;
    --nf-ft2-content-max: {{ content_max }}px;
    --nf-ft2-overlay: {{ overlay_a }};
    --nf-ft2-inset: {{ inset }}px;
  "
>
  <div class="nf-footer-2__media" aria-hidden="true">
    {% render 'nf-media',
      video: section.settings.background_video,
      image: section.settings.background_image,
      asset: section.settings.background_asset,
      class: 'nf-footer-2__bg',
      alt: '',
      loading: 'lazy',
      sizes: '100vw',
      autoplay: true
    %}
    <div class="nf-footer-2__overlay"></div>
  </div>

  <div class="nf-footer-2__glass">
    <div class="nf-footer-2__inner">
      {%- if section.settings.headline != blank -%}
        <p class="nf-footer-2__headline">{{ section.settings.headline | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        {%- assign footer2_cta_url = section.settings.cta_url | default: routes.all_products_collection_url -%}
        {% render 'nf-button',
          label: section.settings.cta_label,
          url: footer2_cta_url,
          style: section.settings.button_style,
          class: 'nf-footer-2__cta'
        %}
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="nf-footer-2__newsletter">
          {% form 'customer', class: 'nf-newsletter-form nf-footer-2__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="nf-footer-2__success">{{ 'footer.newsletter.success' | t }}</p>
            {%- else -%}
              <label class="nf-visually-hidden" for="NFFooter2NewsletterEmail">{{ 'footer.newsletter.label' | t }}</label>
              <input
                id="NFFooter2NewsletterEmail"
                type="email"
                name="contact[email]"
                class="nf-input"
                placeholder="{{ section.settings.newsletter_placeholder | default: 'Your email' | escape }}"
                required
              >
              <button type="submit" class="nf-btn">{{ 'footer.newsletter.submit' | t }}</button>
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}

      {%- liquid
        assign menu_1 = section.settings.menu_1
        assign menu_2 = section.settings.menu_2
        assign menu_3 = section.settings.menu_3
        assign has_menus = false
        if menu_1 != blank and menu_1.links.size > 0
          assign has_menus = true
        endif
        if menu_2 != blank and menu_2.links.size > 0
          assign has_menus = true
        endif
        if menu_3 != blank and menu_3.links.size > 0
          assign has_menus = true
        endif
        assign has_social = false
        if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_youtube != blank
          assign has_social = true
        endif
      -%}

      {%- if has_menus or has_social -%}
        <div class="nf-footer-2__grid">
          {%- if has_menus -%}
            <div class="nf-footer-2__menus">
              {%- if menu_1 != blank and menu_1.links.size > 0 -%}
                <nav class="nf-footer-2__menu" aria-label="{{ section.settings.menu_1_heading | default: menu_1.title | escape }}">
                  {%- if section.settings.menu_1_heading != blank -%}
                    <p class="nf-footer-2__menu-heading">{{ section.settings.menu_1_heading | escape }}</p>
                  {%- endif -%}
                  <ul class="nf-footer-2__menu-list">
                    {%- for link in menu_1.links -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
              {%- endif -%}

              {%- if menu_2 != blank and menu_2.links.size > 0 -%}
                <nav class="nf-footer-2__menu" aria-label="{{ section.settings.menu_2_heading | default: menu_2.title | escape }}">
                  {%- if section.settings.menu_2_heading != blank -%}
                    <p class="nf-footer-2__menu-heading">{{ section.settings.menu_2_heading | escape }}</p>
                  {%- endif -%}
                  <ul class="nf-footer-2__menu-list">
                    {%- for link in menu_2.links -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
              {%- endif -%}

              {%- if menu_3 != blank and menu_3.links.size > 0 -%}
                <nav class="nf-footer-2__menu" aria-label="{{ section.settings.menu_3_heading | default: menu_3.title | escape }}">
                  {%- if section.settings.menu_3_heading != blank -%}
                    <p class="nf-footer-2__menu-heading">{{ section.settings.menu_3_heading | escape }}</p>
                  {%- endif -%}
                  <ul class="nf-footer-2__menu-list">
                    {%- for link in menu_3.links -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if has_social -%}
            <div class="nf-footer-2__social">
              {%- if settings.social_instagram != blank -%}
                <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
              {%- endif -%}
              {%- if settings.social_tiktok != blank -%}
                <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>
              {%- endif -%}
              {%- if settings.social_youtube != blank -%}
                <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener">YouTube</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <p class="nf-footer-2__meta">
        {{ section.settings.copyright_note | default: 'All rights reserved' | escape }}
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NF Footer 2",
  "tag": "section",
  "class": "nf-footer-2-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Sparkling water, anywhere."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop bottles"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "fill", "label": "Fill" },
        { "value": "outline", "label": "Outline" },
        { "value": "link", "label": "Linked text underline" }
      ],
      "default": "fill"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "copyright_note",
      "label": "Copyright note",
      "default": "All rights reserved"
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "Menu 1 heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Menu 2 heading"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    },
    {
      "type": "text",
      "id": "menu_3_heading",
      "label": "Menu 3 heading"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu 3"
    },
    {
      "type": "header",
      "content": "Background media"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Shopify Files MP4. Autoplay is muted and looped. Preferred over image when set."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Used when no video is set. Supports focal point."
    },
    {
      "type": "text",
      "id": "background_asset",
      "label": "Theme asset fallback",
      "info": "Filename in theme assets/ when video and image are empty."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 320,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Media overlay opacity",
      "min": 0,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 20,
      "info": "Darkens the media behind the glass for contrast."
    },
    {
      "type": "header",
      "content": "Glass style"
    },
    {
      "type": "range",
      "id": "glass_blur",
      "label": "Glass blur",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "label": "Glass tint opacity",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 28
    },
    {
      "type": "color",
      "id": "glass_tint",
      "label": "Glass tint",
      "default": "#0a3d3f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "glass_padding",
      "label": "Glass inner padding",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "glass_inset",
      "label": "Glass inset from edges",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 640,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    }
  ],
  "presets": [
    {
      "name": "NF Footer 2",
      "settings": {
        "headline": "Sparkling water, anywhere.",
        "cta_label": "Shop bottles",
        "show_newsletter": true,
        "menu_1_heading": "Shop"
      }
    }
  ],
  "enabled_on": {
    "templates": ["*"],
    "groups": ["footer"]
  }
}
{% endschema %}
