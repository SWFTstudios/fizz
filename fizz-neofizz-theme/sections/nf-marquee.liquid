<section class="nf-marquee" id="{{ section.settings.anchor_id | default: 'marquee' | handle }}" data-nf-marquee data-nf-reveal>
  <div class="nf-marquee__track" data-nf-marquee-track aria-hidden="true">
    {%- for i in (1..2) -%}
      <div class="nf-marquee__group">
        {%- for block in section.blocks -%}
          <span class="nf-marquee__item" {{ block.shopify_attributes }}>
            {%- if section.settings.show_glyph -%}
              <span class="nf-marquee__glyph" aria-hidden="true">●</span>
            {%- endif -%}
            {{ block.settings.text | escape }}
          </span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
  <span class="nf-visually-hidden">
    {%- for block in section.blocks -%}{{ block.settings.text | escape }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}
  </span>
</section>

{% schema %}
{
  "name": "NF Marquee",
  "tag": "section",
  "class": "nf-marquee-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "marquee"
    },
    {
      "type": "checkbox",
      "id": "show_glyph",
      "label": "Show separators",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Word",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FIZZ ANYWHERE"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "NF Marquee",
      "blocks": [
        { "type": "word", "settings": { "text": "FIZZ ANYWHERE" } },
        { "type": "word", "settings": { "text": "ZERO SUGAR" } },
        { "type": "word", "settings": { "text": "REAL FRUIT" } },
        { "type": "word", "settings": { "text": "60 FIZZES PER POD" } },
        { "type": "word", "settings": { "text": "PORTABLE" } },
        { "type": "word", "settings": { "text": "COLD BUBBLES" } }
      ]
    }
  ]
}
{% endschema %}
