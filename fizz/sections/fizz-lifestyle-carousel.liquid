{% render 'fizz-section-spacing', section: section %}

{{ 'fizz-lifestyle-carousel.css' | asset_url | stylesheet_tag }}
{% unless template.name == 'index' %}
  {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{% endunless %}

{% liquid
  assign bottle_product = section.settings.bottle_product
  if bottle_product == blank
    assign bottle_product = all_products['fizz-bottle']
  endif

  assign autoplay_ms = section.settings.autoplay_seconds | default: 0 | times: 1000
  assign card_radius = section.settings.card_radius | default: 28
  assign bg_tint = section.settings.background_tint | default: '#c8d5c0'
%}

{% if section.blocks.size > 0 %}
  <section
    class="fizz-lifestyle-carousel"
    data-fizz-lifestyle-carousel
    data-autoplay-ms="{{ autoplay_ms }}"
    data-show-arrows="{{ section.settings.show_arrows }}"
    data-coverflow-rotate="{{ section.settings.coverflow_rotate | default: 42 }}"
    data-coverflow-depth="{{ section.settings.coverflow_depth | default: 180 }}"
    aria-label="{{ section.settings.heading | default: 'Lifestyle carousel' | escape }}"
    style="--flc-radius: {{ card_radius }}px; --flc-tint: {{ bg_tint }};"
  >
    <div class="fizz-lifestyle-carousel__atmosphere" aria-hidden="true"></div>

    <div class="fizz-lifestyle-carousel__inner">
      {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="fizz-lifestyle-carousel__header">
          {% if section.settings.eyebrow != blank %}
            <p class="fizz-lifestyle-carousel__eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="fizz-lifestyle-carousel__lead">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="fizz-lifestyle-carousel__shell{% if section.blocks.size < 2 %} fizz-lifestyle-carousel__shell--single{% endif %}">
        {% if section.settings.show_arrows and section.blocks.size > 1 %}
          <button
            type="button"
            class="fizz-slide-arrow fizz-slide-arrow--left fizz-lifestyle-carousel__arrow fizz-lifestyle-carousel__arrow--prev"
            data-fizz-lifestyle-prev
            aria-label="Previous slide"
          >
            <img src="{{ 'fizz-arrow-left.svg' | asset_url }}" alt="" width="24" height="24">
          </button>
        {% endif %}

        <div class="swiper fizz-lifestyle-carousel__swiper" data-fizz-lifestyle-swiper>
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% liquid
                assign color_slug = block.settings.color_slug
                assign card_variant = ''
                assign card_url = ''

                if bottle_product != blank
                  for variant in bottle_product.variants
                    capture vslug_raw
                      render 'fizz-color-slug', variant: variant
                    endcapture
                    assign vslug = vslug_raw | strip
                    if vslug == color_slug
                      assign card_variant = variant
                      break
                    endif
                  endfor

                  if card_variant != blank
                    assign card_url = bottle_product.url | append: '?variant=' | append: card_variant.id
                  else
                    assign card_url = bottle_product.url
                  endif
                endif

                assign card_title = block.settings.title
                if card_title == blank and card_variant != blank
                  assign card_title = card_variant.title
                endif

                assign lifestyle_image = block.settings.lifestyle_image
                assign hover_image = block.settings.hover_image
                if hover_image == blank and card_variant != blank and card_variant.image != blank
                  assign hover_image = card_variant.image
                endif

                assign image_alt = block.settings.image_alt
                if image_alt == blank
                  assign image_alt = card_title | default: color_slug
                endif

                assign has_asset_fallback = false
                if lifestyle_image == blank and color_slug != blank
                  assign has_asset_fallback = true
                  assign asset_src = 'hero-lifestyle-' | append: color_slug | append: '.png' | asset_url
                endif

                assign show_hover = false
                if hover_image != blank
                  if lifestyle_image == blank or hover_image != lifestyle_image
                    assign show_hover = true
                  endif
                endif
              %}

              <div class="swiper-slide" {{ block.shopify_attributes }}>
                {% if card_url != blank %}
                  <a href="{{ card_url }}" class="fizz-lifestyle-carousel__card fizz-lifestyle-carousel__card--{{ color_slug }}">
                {% else %}
                  <article class="fizz-lifestyle-carousel__card fizz-lifestyle-carousel__card--{{ color_slug }}">
                {% endif %}
                  <div class="fizz-lifestyle-carousel__media{% if show_hover %} fizz-lifestyle-carousel__media--has-hover{% endif %}">
                    {% if lifestyle_image != blank %}
                      {{
                        lifestyle_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'fizz-lifestyle-carousel__img fizz-lifestyle-carousel__img--primary',
                          loading: 'lazy',
                          widths: '400, 600, 900',
                          sizes: '(min-width: 1024px) 28vw, 70vw',
                          alt: image_alt
                      }}
                    {% elsif has_asset_fallback %}
                      <img
                        class="fizz-lifestyle-carousel__img fizz-lifestyle-carousel__img--primary"
                        src="{{ asset_src }}"
                        alt="{{ image_alt | escape }}"
                        loading="lazy"
                        width="900"
                        height="900"
                      >
                    {% elsif card_variant != blank and card_variant.image != blank %}
                      {{
                        card_variant.image
                        | image_url: width: 900
                        | image_tag:
                          class: 'fizz-lifestyle-carousel__img fizz-lifestyle-carousel__img--primary',
                          loading: 'lazy',
                          widths: '400, 600, 900',
                          sizes: '(min-width: 1024px) 28vw, 70vw',
                          alt: image_alt
                      }}
                    {% elsif bottle_product != blank and bottle_product.featured_image != blank %}
                      {{
                        bottle_product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'fizz-lifestyle-carousel__img fizz-lifestyle-carousel__img--primary',
                          loading: 'lazy',
                          widths: '400, 600, 900',
                          sizes: '(min-width: 1024px) 28vw, 70vw',
                          alt: image_alt
                      }}
                    {% else %}
                      <div class="fizz-lifestyle-carousel__placeholder" aria-hidden="true"></div>
                    {% endif %}

                    {% if show_hover %}
                      {{
                        hover_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'fizz-lifestyle-carousel__img fizz-lifestyle-carousel__img--secondary',
                          loading: 'lazy',
                          widths: '400, 600, 900',
                          sizes: '(min-width: 1024px) 28vw, 70vw',
                          alt: image_alt
                      }}
                    {% endif %}
                  </div>

                  {% if card_title != blank or block.settings.caption != blank %}
                    <div class="fizz-lifestyle-carousel__meta">
                      {% if card_title != blank %}
                        <p class="fizz-lifestyle-carousel__title">{{ card_title }}</p>
                      {% endif %}
                      {% if block.settings.caption != blank %}
                        <p class="fizz-lifestyle-carousel__caption">{{ block.settings.caption }}</p>
                      {% endif %}
                    </div>
                  {% endif %}
                {% if card_url != blank %}
                  </a>
                {% else %}
                  </article>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>

        {% if section.settings.show_arrows and section.blocks.size > 1 %}
          <button
            type="button"
            class="fizz-slide-arrow fizz-slide-arrow--right fizz-lifestyle-carousel__arrow fizz-lifestyle-carousel__arrow--next"
            data-fizz-lifestyle-next
            aria-label="Next slide"
          >
            <img src="{{ 'fizz-arrow-right.svg' | asset_url }}" alt="" width="24" height="24">
          </button>
        {% endif %}
      </div>
    </div>
  </section>

  {% unless template.name == 'index' %}
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
    <script src="{{ 'fizz-lifestyle-carousel.js' | asset_url }}" defer></script>
  {% endunless %}
{% endif %}

{% schema %}
{
  "name": "Fizz lifestyle carousel",
  "tag": "section",
  "class": "fizz-lifestyle-carousel-section fizz-section--spaced fizz-section--relaxed",
  "settings": [
    { "type": "header", "content": "Section spacing" },
    {
      "type": "select",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "options": [
        { "value": "flush", "label": "None" },
        { "value": "compact", "label": "Compact" },
        { "value": "default", "label": "Default" },
        { "value": "relaxed", "label": "Relaxed" },
        { "value": "statement", "label": "Statement" },
        { "value": "hero", "label": "Hero band" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "relaxed"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top (custom)",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (custom)",
      "default": 96
    },
    {
      "type": "select",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "full", "label": "Full width" },
        { "value": "none", "label": "None" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding left (custom)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding right (custom)",
      "default": 20
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the finish" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your color" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Lifestyle looks for every bottle finish. Hover for a closer view, then shop the color."
    },
    {
      "type": "product",
      "id": "bottle_product",
      "label": "Bottle product",
      "info": "Defaults to fizz-bottle when empty. Cards link with ?variant= for the matched color."
    },
    { "type": "header", "content": "Carousel" },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Autoplay interval (seconds, 0 = off)",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show prev/next arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "coverflow_rotate",
      "label": "Side card rotation",
      "min": 20,
      "max": 60,
      "step": 2,
      "default": 42
    },
    {
      "type": "range",
      "id": "coverflow_depth",
      "label": "3D depth",
      "min": 80,
      "max": 320,
      "step": 10,
      "default": 180
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    { "type": "header", "content": "Section background" },
    {
      "type": "color",
      "id": "background_tint",
      "label": "Atmosphere tint",
      "default": "#c8d5c0",
      "info": "Soft blurred wash behind the carousel"
    },
    { "type": "color", "id": "background_color", "label": "Background color" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Color card",
      "settings": [
        {
          "type": "select",
          "id": "color_slug",
          "label": "Bottle color",
          "options": [
            { "value": "coral-orange", "label": "Coral Orange" },
            { "value": "charcoal-black", "label": "Charcoal Black" },
            { "value": "sage-green", "label": "Sage Green" },
            { "value": "steel-navy", "label": "Steel Navy" },
            { "value": "arctic-white", "label": "Arctic White" },
            { "value": "electric-blue", "label": "Electric Blue" }
          ],
          "default": "coral-orange",
          "info": "Links to the matching bottle variant via ?variant="
        },
        { "type": "image_picker", "id": "lifestyle_image", "label": "Lifestyle image" },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover image",
          "info": "Falls back to the variant image when empty"
        },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fizz lifestyle carousel",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "color_slug": "coral-orange",
            "title": "Coral Orange",
            "caption": "Bright citrus energy"
          }
        },
        {
          "type": "card",
          "settings": {
            "color_slug": "sage-green",
            "title": "Sage Green",
            "caption": "Calm everyday ritual"
          }
        },
        {
          "type": "card",
          "settings": {
            "color_slug": "charcoal-black",
            "title": "Charcoal Black",
            "caption": "After-hours polish"
          }
        },
        {
          "type": "card",
          "settings": {
            "color_slug": "electric-blue",
            "title": "Electric Blue",
            "caption": "Poolside spark"
          }
        },
        {
          "type": "card",
          "settings": {
            "color_slug": "arctic-white",
            "title": "Arctic White",
            "caption": "Clean and minimal"
          }
        },
        {
          "type": "card",
          "settings": {
            "color_slug": "steel-navy",
            "title": "Steel Navy",
            "caption": "Deep evening tone"
          }
        }
      ]
    }
  ]
}
{% endschema %}
