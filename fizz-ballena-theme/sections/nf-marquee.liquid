{%- liquid
  assign logo_h = section.settings.logo_height | default: 24
  assign logo_img_w = logo_h | times: 4 | at_least: 80
  assign text_color = section.settings.text_color
  if text_color == blank
    assign text_color = 'rgba(var(--nf-ink-rgb), 0.55)'
  endif
  assign bg_color = section.settings.background_color
  if bg_color == blank
    assign bg_color = 'var(--nf-paper)'
  endif
  assign glyph_color = section.settings.separator_color
  if glyph_color == blank
    assign glyph_color = 'var(--nf-accent)'
  endif
  assign use_theme_spacing = section.settings.use_theme_spacing
  if use_theme_spacing == nil
    assign use_theme_spacing = false
  endif
  unless use_theme_spacing
    assign pad_unit = section.settings.padding_unit | default: 'rem'
    assign pad_top = section.settings.padding_top | default: 2 | append: pad_unit
    assign pad_bottom = section.settings.padding_bottom | default: 1 | append: pad_unit
  endunless
-%}

{%- if use_theme_spacing -%}
  {% render 'bf-section-padding', section: section %}
{%- endif -%}

{% style %}
  {{ section.settings.marquee_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }} {
    --nf-marquee-font: {{ section.settings.marquee_font.family }}, {{ section.settings.marquee_font.fallback_families }};
    --nf-marquee-font-weight: {{ section.settings.marquee_font.weight }};
    --nf-marquee-font-style: {{ section.settings.marquee_font.style }};
    --nf-marquee-font-size: {{ section.settings.font_size }}px;
    --nf-marquee-font-size-mobile: {{ section.settings.font_size_mobile }}px;
    --nf-marquee-transform: {{ section.settings.text_transform }};
    --nf-marquee-color: {{ text_color }};
    --nf-marquee-glyph: {{ glyph_color }};
    --nf-marquee-logo-h: {{ logo_h }}px;
    --nf-marquee-gap: {{ section.settings.item_gap }}px;
    --nf-marquee-duration: {{ section.settings.speed }}s;
    --nf-marquee-bg: {{ bg_color }};
    {%- if use_theme_spacing -%}
      --nf-marquee-pad-top: var(--bf-pad-top, 0px);
      --nf-marquee-pad-bottom: var(--bf-pad-bottom, 0px);
    {%- else -%}
      --nf-marquee-pad-top: {{ pad_top }};
      --nf-marquee-pad-bottom: {{ pad_bottom }};
    {%- endif -%}
  }
{% endstyle %}

<section
  class="nf-marquee"
  id="{{ section.settings.anchor_id | default: 'marquee' | handle }}"
  data-nf-marquee
  data-nf-reveal
  data-nf-speed="{{ section.settings.speed }}"
>
  <div class="nf-marquee__track" data-nf-marquee-track>
    {%- for block in section.blocks -%}
      <span class="nf-marquee__item" data-nf-marquee-item {{ block.shopify_attributes }}>
        {%- if section.settings.show_glyph -%}
          <span class="nf-marquee__glyph" aria-hidden="true">●</span>
        {%- endif -%}
        {%- if block.type == 'image' -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: logo_img_w
              | image_tag:
                loading: 'lazy',
                alt: block.settings.alt,
                height: logo_h,
                class: 'nf-marquee__logo'
            }}
          {%- endif -%}
        {%- elsif block.settings.text != blank -%}
          <span class="nf-marquee__text">{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </span>
    {%- endfor -%}
  </div>
  <span class="nf-visually-hidden">
    {%- assign nf_marquee_labels = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'word' and block.settings.text != blank -%}
        {%- if nf_marquee_labels != blank -%}
          {%- assign nf_marquee_labels = nf_marquee_labels | append: ', ' -%}
        {%- endif -%}
        {%- assign nf_marquee_labels = nf_marquee_labels | append: block.settings.text -%}
      {%- endif -%}
    {%- endfor -%}
    {{ nf_marquee_labels | escape }}
  </span>
</section>

{% schema %}
{
  "name": "NF Marquee",
  "tag": "section",
  "class": "nf-marquee-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "marquee"
    },
    {
      "type": "font_picker",
      "id": "marquee_font",
      "label": "Font",
      "default": "work_sans_n4"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "label": "Font size (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" }
      ],
      "default": "lowercase"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 12,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Logo height",
      "default": 24
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Item spacing",
      "default": 28
    },
    {
      "type": "range",
      "id": "speed",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Loop duration",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "show_glyph",
      "label": "Show separators",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "use_theme_spacing",
      "label": "Use global padding",
      "info": "Uses Theme settings → Layout for desktop and mobile padding. Turn off to keep rem/px unit controls below.",
      "default": false
    },
    {
      "type": "select",
      "id": "padding_unit",
      "label": "Padding unit",
      "options": [
        { "value": "px", "label": "px" },
        { "value": "rem", "label": "rem" },
        { "value": "char", "label": "char" },
        { "value": "vh", "label": "vh" }
      ],
      "default": "rem",
      "info": "Applies to padding top and bottom. Use smaller numbers for rem, char, and vh.",
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Padding top",
      "default": 2,
      "info": "Interpreted in the selected padding unit",
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Padding bottom",
      "default": 1,
      "info": "Interpreted in the selected padding unit",
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Word",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FIZZ ANYWHERE"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Logo"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "NF Marquee",
      "blocks": [
        { "type": "word", "settings": { "text": "FIZZ ANYWHERE" } },
        { "type": "word", "settings": { "text": "ZERO SUGAR" } },
        { "type": "word", "settings": { "text": "REAL FRUIT" } },
        { "type": "word", "settings": { "text": "60 FIZZES PER POD" } },
        { "type": "word", "settings": { "text": "PORTABLE" } },
        { "type": "word", "settings": { "text": "COLD BUBBLES" } }
      ]
    }
  ]
}
{% endschema %}
