{{ 'bf-footer.css' | asset_url | stylesheet_tag }}

<footer
  class="bf-section bf-footer"
  id="{{ section.settings.anchor_id | default: 'footer' | handle }}"
>
  {% render 'bf-section-chrome', section: section %}
  <div class="bf-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="bf-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="bf-section__body">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      {%- assign footer_cta = section.settings.cta_url | default: routes.all_products_collection_url -%}
      <a class="bf-btn" href="{{ footer_cta }}">{{ section.settings.cta_label | escape }}</a>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <div class="bf-footer__newsletter">
        {% form 'customer', class: 'bf-newsletter' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p>{{ 'footer.newsletter.success' | t }}</p>
          {%- else -%}
            <label class="nf-visually-hidden" for="BFNewsletterEmail">{{ 'footer.newsletter.label' | t }}</label>
            <input
              id="BFNewsletterEmail"
              type="email"
              name="contact[email]"
              class="bf-footer__input"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Your email' | escape }}"
              required
            >
            <button type="submit" class="bf-btn bf-btn--ghost">{{ 'footer.newsletter.submit' | t }}</button>
          {%- endif -%}
        {% endform %}
      </div>
    {%- endif -%}

    <nav class="bf-footer__links" aria-label="Footer">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="bf-footer__social">
      {%- if settings.social_instagram != blank -%}
        <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
      {%- endif -%}
      {%- if settings.social_tiktok != blank -%}
        <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>
      {%- endif -%}
    </div>

    <p class="bf-footer__meta">
      {{ section.settings.copyright_note | default: 'All rights reserved' | escape }}
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
    </p>
  </div>
</footer>

