{% render 'bf-section-padding', section: section %}
{% style %}
  /* bf-section-padding-apply */
  #shopify-section-{{ section.id }} .nf-mosaic {
    padding-block: var(--bf-pad-top, 0) var(--bf-pad-bottom, 0);
  }
{% endstyle %}

<section
  class="nf-mosaic"
  id="{{ section.settings.anchor_id | default: 'gallery' }}"
  data-nf-mosaic
  style="--mosaic-gap: {{ section.settings.gap }}px; --mosaic-radius: {{ section.settings.radius }}px;"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="nf-visually-hidden">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div
    class="nf-mosaic__grid nf-mosaic__grid--m{{ section.settings.mobile_columns }} nf-mosaic__grid--d{{ section.settings.desktop_columns }}"
    data-nf-mosaic-grid
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign span_desktop = block.settings.span | default: 4
        assign tag = 'div'
        if block.settings.link != blank
          assign tag = 'a'
        endif
      -%}
      <{{ tag }}
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        class="nf-tile nf-tile--span{{ span_desktop }}{% if block.settings.tall %} nf-tile--tall{% endif %}{% if block.settings.wide_mobile %} nf-tile--wide-m{% endif %}"
        data-nf-tile
        {{ block.shopify_attributes }}
      >
        {%- render 'nf-media',
          video: block.settings.video,
          video_url: block.settings.video_url,
          image: block.settings.image,
          asset: block.settings.asset,
          alt: block.settings.caption,
          class: 'nf-tile__media',
          sizes: '(min-width: 750px) 33vw, 100vw'
        -%}
        {%- if block.settings.caption != blank -%}
          <span class="nf-tile__caption">{{ block.settings.caption | escape }}</span>
        {%- endif -%}
      </{{ tag }}>
    {%- endfor -%}
  </div>
</section>

