{{ 'nf-horizontal-benefits.css' | asset_url | stylesheet_tag }}
{% render 'bf-section-padding', section: section %}

{% liquid
  assign card_width = section.settings.card_width | default: 420
  assign card_gap = section.settings.card_gap | default: 24
  assign card_radius = section.settings.card_radius | default: 20
  assign overlay_opacity = section.settings.overlay_opacity | default: 45
  assign scroll_speed_pct = section.settings.scroll_speed | default: 100
  assign default_orientation = section.settings.card_orientation | default: 'portrait'
  assign default_ratio = section.settings.card_ratio | default: '3/4'
  assign color_eyebrow = section.settings.color_eyebrow | default: '#8a948c'
  assign color_heading = section.settings.color_heading | default: '#0e1412'
  assign color_lead = section.settings.color_lead | default: '#3a423e'
  assign color_card_title = section.settings.color_card_title | default: '#ffffff'
  assign color_card_body = section.settings.color_card_body | default: 'rgba(255,255,255,0.88)'
  assign bg_media_opacity = section.settings.background_media_opacity | default: 100 | times: 1.0 | divided_by: 100.0
  assign has_bg_image = false
  if section.settings.background_image != blank
    assign has_bg_image = true
  endif
  assign has_bg_video = false
  if section.settings.background_video != blank or section.settings.background_video_url != blank
    assign has_bg_video = true
  endif
  assign show_head = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank
    assign show_head = true
  endif
%}

{% liquid
  assign def_parts = default_ratio | split: '/'
  assign def_w = def_parts[0] | plus: 0
  assign def_h = def_parts[1] | plus: 0
  if def_w < 1
    assign def_w = 3
  endif
  if def_h < 1
    assign def_h = 4
  endif

  if default_orientation == 'square'
    assign default_aspect = '1 / 1'
  elsif default_orientation == 'landscape'
    if def_h > def_w
      assign default_aspect = def_h | append: ' / ' | append: def_w
    else
      assign default_aspect = def_w | append: ' / ' | append: def_h
    endif
  else
    if def_w > def_h
      assign default_aspect = def_h | append: ' / ' | append: def_w
    else
      assign default_aspect = def_w | append: ' / ' | append: def_h
    endif
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 1;
    {%- if section.settings.background_color != blank -%}
    background-color: {{ section.settings.background_color }};
    {%- endif -%}
  }
{% endstyle %}

<section
  class="nf-hbenefits"
  id="{{ section.settings.anchor_id | default: 'benefits-scroll' | handle }}"
  data-nf-hbenefits
  data-scroll-speed="{{ scroll_speed_pct }}"
  style="
    --nf-hben-w: {{ card_width }}px;
    --nf-hben-gap: {{ card_gap }}px;
    --nf-hben-radius: {{ card_radius }}px;
    --nf-hben-ratio: {{ default_aspect }};
    --nf-hben-overlay: {{ overlay_opacity | times: 1.0 | divided_by: 100.0 }};
    --nf-hben-eyebrow: {{ color_eyebrow }};
    --nf-hben-heading: {{ color_heading }};
    --nf-hben-lead: {{ color_lead }};
    --nf-hben-card-title: {{ color_card_title }};
    --nf-hben-card-body: {{ color_card_body }};
    --nf-hben-bg-opacity: {{ bg_media_opacity }};
  "
  aria-label="{{ section.settings.heading | default: 'Benefits' | escape }}"
>
  <div class="nf-hbenefits__track" data-nf-hben-track>
    <div class="nf-hbenefits__sticky" data-nf-hben-sticky>
      {%- if has_bg_image or has_bg_video -%}
        <div class="nf-hbenefits__bg" aria-hidden="true">
          {%- if has_bg_image -%}
            <div class="nf-hbenefits__bg-image">
              {{
                section.settings.background_image
                | image_url: width: 2880
                | image_tag:
                  class: 'nf-hbenefits__bg-media',
                  loading: 'lazy',
                  sizes: '100vw',
                  widths: '720, 1080, 1440, 1920, 2880',
                  alt: ''
              }}
            </div>
          {%- endif -%}
          {%- if has_bg_video -%}
            <div class="nf-hbenefits__bg-video">
              {%- render 'nf-media',
                video: section.settings.background_video,
                video_url: section.settings.background_video_url,
                class: 'nf-hbenefits__bg-media',
                alt: '',
                loading: 'lazy',
                sizes: '100vw',
                autoplay: true
              -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      {% if show_head %}
        <div class="nf-hbenefits__head nf-container">
          {% if section.settings.eyebrow != blank %}
            <p class="nf-eyebrow nf-hbenefits__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="nf-heading nf-hbenefits__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="nf-hbenefits__lead">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="nf-hbenefits__viewport" data-nf-hben-viewport>
        <div class="nf-hbenefits__rail" data-nf-hben-rail>
          {% for block in section.blocks %}
            {% if block.type != 'benefit' %}{% continue %}{% endif %}

            {% liquid
              assign use_custom = block.settings.use_custom_size
              assign b_width = card_width
              assign b_orientation = default_orientation
              assign b_ratio = default_ratio
              if use_custom
                assign b_width = block.settings.card_width | default: card_width
                assign b_orientation = block.settings.card_orientation | default: default_orientation
                assign b_ratio = block.settings.card_ratio | default: default_ratio
              endif

              assign b_parts = b_ratio | split: '/'
              assign b_w = b_parts[0] | plus: 0
              assign b_h = b_parts[1] | plus: 0
              if b_w < 1
                assign b_w = 3
              endif
              if b_h < 1
                assign b_h = 4
              endif

              if b_orientation == 'square'
                assign b_aspect = '1 / 1'
              elsif b_orientation == 'landscape'
                if b_h > b_w
                  assign b_aspect = b_h | append: ' / ' | append: b_w
                else
                  assign b_aspect = b_w | append: ' / ' | append: b_h
                endif
              else
                if b_w > b_h
                  assign b_aspect = b_h | append: ' / ' | append: b_w
                else
                  assign b_aspect = b_w | append: ' / ' | append: b_h
                endif
              endif

              assign text_pos = block.settings.text_position | default: 'bottom-left'
              assign image_alt = block.settings.title | default: 'Benefit'
              assign has_link = false
              if block.settings.link != blank and block.settings.link_label != blank
                assign has_link = true
              endif
            %}

            <article
              class="nf-hbenefits__card nf-hbenefits__card--{{ text_pos }}"
              style="--nf-hben-w: {{ b_width }}px; --nf-hben-ratio: {{ b_aspect }};"
              data-nf-hben-card
              {{ block.shopify_attributes }}
            >
              <div class="nf-hbenefits__media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      class: 'nf-hbenefits__img',
                      loading: 'lazy',
                      widths: '480, 720, 960, 1200, 1600',
                      sizes: '(min-width: 750px) 40vw, 90vw',
                      alt: image_alt
                  }}
                {% else %}
                  <div class="nf-hbenefits__placeholder" aria-hidden="true"></div>
                {% endif %}
                <div class="nf-hbenefits__overlay" aria-hidden="true"></div>
              </div>

              <div class="nf-hbenefits__copy">
                {% if block.settings.title != blank %}
                  <h3 class="nf-hbenefits__title">{{ block.settings.title | escape }}</h3>
                {% endif %}
                {% if block.settings.body != blank %}
                  <p class="nf-hbenefits__body">{{ block.settings.body | escape }}</p>
                {% endif %}
                {% if has_link %}
                  <a class="nf-hbenefits__cta" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'nf-horizontal-benefits.js' | asset_url }}" defer></script>

{% schema %}
{
