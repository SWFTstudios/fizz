          "group": "Rem"
        },
        {
          "value": "2.5rem",
          "label": "2.5rem",
          "group": "Rem"
        },
        {
          "value": "3rem",
          "label": "3rem",
          "group": "Rem"
        },
        {
          "value": "4%",
          "label": "4%",
          "group": "Percent"
        },
        {
          "value": "5%",
          "label": "5%",
          "group": "Percent"
        },
        {
          "value": "6%",
          "label": "6%",
          "group": "Percent"
        },
        {
          "value": "8%",
          "label": "8%",
          "group": "Percent"
        },
        {
          "value": "10%",
          "label": "10%",
          "group": "Percent"
        },
        {
          "value": "0",
          "label": "Full width",
          "group": "Full width"
        }
      ],
      "default": "0",
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "select",
