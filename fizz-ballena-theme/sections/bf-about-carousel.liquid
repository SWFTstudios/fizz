{{ 'bf-about-carousel.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign nav_icon = section.settings.nav_icon_color | default: '#03090D'
  assign nav_border = section.settings.nav_border_color | default: '#03090D'
  assign nav_border_op = section.settings.nav_border_opacity | default: 13 | times: 1.0 | divided_by: 100.0
  assign nav_track = section.settings.nav_track_color | default: '#03090D'
  assign nav_track_op = section.settings.nav_track_opacity | default: 20 | times: 1.0 | divided_by: 100.0
  assign nav_progress = section.settings.nav_progress_color | default: '#03090D'
  assign nav_focus = section.settings.nav_focus_color | default: '#6b9fd4'
  assign nav_border_a = nav_border | color_modify: 'alpha', nav_border_op
  assign nav_track_a = nav_track | color_modify: 'alpha', nav_track_op
  assign card_width = section.settings.card_width | default: 360
  assign card_gap = section.settings.card_gap | default: 14
  assign card_radius = section.settings.card_radius | default: 8
  assign default_orientation = section.settings.card_orientation | default: 'portrait'
  assign default_ratio = section.settings.card_ratio | default: '4/5'
  assign color_eyebrow = section.settings.eyebrow_color | default: '#8a948c'
  assign show_head = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank
    assign show_head = true
  endif
-%}

{% liquid
  assign def_parts = default_ratio | split: '/'
  assign def_w = def_parts[0] | plus: 0
  assign def_h = def_parts[1] | plus: 0
  if def_w < 1
    assign def_w = 4
  endif
  if def_h < 1
    assign def_h = 5
  endif

  if default_orientation == 'square'
    assign default_aspect = '1 / 1'
  elsif default_orientation == 'landscape'
    if def_h > def_w
      assign default_aspect = def_h | append: ' / ' | append: def_w
    else
      assign default_aspect = def_w | append: ' / ' | append: def_h
    endif
  else
    if def_w > def_h
      assign default_aspect = def_h | append: ' / ' | append: def_w
    else
      assign default_aspect = def_w | append: ' / ' | append: def_h
    endif
  endif
%}
{% style %}
  #shopify-section-{{ section.id }} .bf-about {
    --bf-about-nav-icon: {{ nav_icon }};
    --bf-about-nav-border: {{ nav_border_a }};
    --bf-about-nav-track: {{ nav_track_a }};
    --bf-about-nav-progress: {{ nav_progress }};
    --bf-about-nav-focus: {{ nav_focus }};
    --bf-about-card-w: {{ card_width }}px;
    --bf-about-card-gap: {{ card_gap }}px;
    --bf-about-card-ratio: {{ default_aspect }};
    --bf-about-card-radius: {{ card_radius }}px;
  }
  #shopify-section-{{ section.id }} .bf-about__navigation {
    border-color: {{ nav_border_a }};
  }
  #shopify-section-{{ section.id }} .bf-about__nav-btn {
    color: {{ nav_icon }};
  }
  #shopify-section-{{ section.id }} .bf-about__nav-btn:focus-visible {
    outline-color: {{ nav_focus }};
  }
  #shopify-section-{{ section.id }} .bf-about__progress {
    background-color: {{ nav_track_a }};
  }
  #shopify-section-{{ section.id }} .bf-about__progress-bar {
    background-color: {{ nav_progress }};
  }
{% endstyle %}
<section
  class="bf-section bf-about{% if section.settings.layout == 'vertical' %} bf-about--vertical{% endif %}"
  id="{{ section.settings.anchor_id | default: 'about' | handle }}"
  data-bf-about
  data-bf-about-layout="{{ section.settings.layout | default: 'horizontal' }}"
  style="
    --bf-about-nav-icon: {{ nav_icon }};
    --bf-about-nav-border: {{ nav_border_a }};
    --bf-about-nav-track: {{ nav_track_a }};
    --bf-about-nav-progress: {{ nav_progress }};
    --bf-about-nav-focus: {{ nav_focus }};
    --bf-about-card-w: {{ card_width }}px;
    --bf-about-card-gap: {{ card_gap }}px;
    --bf-about-card-ratio: {{ default_aspect }};
    --bf-about-card-radius: {{ card_radius }}px;
    --bf-about-eyebrow: {{ color_eyebrow }};
  "
>
  {% render 'bf-section-chrome', section: section %}

  <button
    type="button"
    class="bf-about__side-btn bf-about__side-btn--prev"
    data-bf-about-prev
    aria-label="Previous"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button
    type="button"
    class="bf-about__side-btn bf-about__side-btn--next"
    data-bf-about-next
    aria-label="Next"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>

  <div class="bf-about__wrap">
    {%- if show_head -%}
      <header class="bf-about__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="nf-eyebrow bf-about__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="bf-section__heading bf-about__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bf-section__body bf-about__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="bf-about__carousel">
      <div class="bf-about__track" data-bf-about-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            {% liquid
              assign card_url = block.settings.url | default: '#'
              assign use_custom = block.settings.use_custom_size
              assign b_width = card_width
              assign b_orientation = default_orientation
              assign b_ratio = default_ratio
              if use_custom
                assign b_width = block.settings.card_width | default: card_width
                assign b_orientation = block.settings.card_orientation | default: default_orientation
                assign b_ratio = block.settings.card_ratio | default: default_ratio
              endif

              assign b_parts = b_ratio | split: '/'
              assign b_w = b_parts[0] | plus: 0
              assign b_h = b_parts[1] | plus: 0
              if b_w < 1
                assign b_w = 4
              endif
              if b_h < 1
                assign b_h = 5
              endif

              if b_orientation == 'square'
                assign b_aspect = '1 / 1'
              elsif b_orientation == 'landscape'
                if b_h > b_w
                  assign b_aspect = b_h | append: ' / ' | append: b_w
                else
                  assign b_aspect = b_w | append: ' / ' | append: b_h
                endif
              else
                if b_w > b_h
                  assign b_aspect = b_h | append: ' / ' | append: b_w
                else
                  assign b_aspect = b_w | append: ' / ' | append: b_h
                endif
              endif

              assign b_radius = card_radius
              if block.settings.use_custom_radius
                assign b_radius = block.settings.card_radius | default: card_radius
              endif
            %}
            <article
              class="bf-about__card"
              style="--bf-about-card-w: {{ b_width }}px; --bf-about-card-ratio: {{ b_aspect }}; --bf-about-card-radius: {{ b_radius }}px;"
              {{ block.shopify_attributes }}
            >
              <div class="bf-about__card-media" aria-hidden="true">
                {%- render 'nf-media',
                  image: block.settings.image,
                  asset: block.settings.asset,
                  alt: block.settings.title,
                  class: 'bf-about__card-img',
                  sizes: '(min-width: 900px) 420px, 80vw',
                  loading: 'lazy'
                -%}
              </div>

              <div class="bf-about__card-content">
                <h3 class="bf-about__card-title">{{ block.settings.title | escape }}</h3>

                <div class="bf-about__card-bottom">
                  {%- if block.settings.body != blank -%}
                    <p class="bf-about__card-desc">{{ block.settings.body | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.link_label != blank -%}
                    <a class="bf-about__card-link" href="{{ card_url }}">
                      <span>{{ block.settings.link_label | escape }}</span>
                      <span class="bf-about__card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="12" cy="12" r="11" fill="currentColor" fill-opacity="0.95"/>
                          <path d="M10.2 7.8L14.4 12l-4.2 4.2" stroke="#03090D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="bf-about__navigation" data-bf-about-nav>
        <button type="button" class="bf-about__nav-btn" data-bf-about-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="bf-about__progress" aria-hidden="true">
          <span class="bf-about__progress-bar" data-bf-about-progress></span>
        </div>
        <button type="button" class="bf-about__nav-btn" data-bf-about-next aria-label="Next">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'bf-about-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "BF About Carousel",
  "tag": "section",
  "class": "bf-about-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "about"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank for Ballena-style image cards with no section title."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal scroll"
        },
        {
          "value": "vertical",
          "label": "Vertical grid (2 + peek)"
        }
      ],
      "default": "horizontal",
      "info": "Vertical shows two cards with a third peeking. Horizontal is the default carousel."
    },
    {
      "type": "header",
      "content": "Card defaults"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 280,
      "max": 720,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "select",
      "id": "card_orientation",
      "label": "Orientation",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Aspect ratio",
      "info": "Combined with orientation. Square always uses 1:1.",
      "options": [
        {
          "value": "3/4",
          "label": "3:4"
        },
        {
          "value": "4/5",
          "label": "4:5"
        },
        {
          "value": "2/3",
          "label": "2:3"
        },
        {
          "value": "1/1",
          "label": "1:1"
        },
        {
          "value": "4/3",
          "label": "4:3"
        },
        {
          "value": "16/9",
          "label": "16:9"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 14
    },
