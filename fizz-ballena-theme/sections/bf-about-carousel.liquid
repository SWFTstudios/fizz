    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank for Ballena-style image cards with no section title."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
