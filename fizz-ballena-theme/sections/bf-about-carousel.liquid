  "presets": [
    {
      "name": "BF About Carousel",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Shop Bottles",
            "body": "Built for the way you move",
            "link_label": "Explore more",
            "url": "/collections/all",
            "asset": "nf-lifestyle-story-01.jpg"
