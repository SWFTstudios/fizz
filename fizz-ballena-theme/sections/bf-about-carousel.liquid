{{ 'bf-about-carousel.css' | asset_url | stylesheet_tag }}
<section
  class="bf-section bf-about"
  id="{{ section.settings.anchor_id | default: 'about' | handle }}"
  data-bf-about
>
  {% render 'bf-section-chrome', section: section %}

  <div class="bf-about__wrap">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="bf-about__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="bf-section__heading bf-about__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bf-section__body bf-about__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="bf-about__carousel">
      <div class="bf-about__track" data-bf-about-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            {%- assign card_url = block.settings.url | default: '#' -%}
            <article class="bf-about__card" {{ block.shopify_attributes }}>
              <div class="bf-about__card-media" aria-hidden="true">
                {%- render 'nf-media',
                  image: block.settings.image,
                  asset: block.settings.asset,
                  alt: block.settings.title,
                  class: 'bf-about__card-img',
                  sizes: '(min-width: 900px) 28vw, 80vw',
                  loading: 'lazy'
                -%}
              </div>

              <div class="bf-about__card-content">
                <h3 class="bf-about__card-title">{{ block.settings.title | escape }}</h3>

                <div class="bf-about__card-bottom">
                  {%- if block.settings.body != blank -%}
                    <p class="bf-about__card-desc">{{ block.settings.body | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.link_label != blank -%}
                    <a class="bf-about__card-link" href="{{ card_url }}">
                      <span>{{ block.settings.link_label | escape }}</span>
                      <span class="bf-about__card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="12" cy="12" r="11" fill="currentColor" fill-opacity="0.95"/>
                          <path d="M10.2 7.8L14.4 12l-4.2 4.2" stroke="#03090D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="bf-about__navigation" data-bf-about-nav>
        <button type="button" class="bf-about__nav-btn" data-bf-about-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="bf-about__progress" aria-hidden="true">
          <span class="bf-about__progress-bar" data-bf-about-progress></span>
        </div>
        <button type="button" class="bf-about__nav-btn" data-bf-about-next aria-label="Next">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'bf-about-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "BF About Carousel",
  "tag": "section",
  "class": "bf-about-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "about"
