{{ 'bf-social-carousel.css' | asset_url | stylesheet_tag }}
<section
  class="bf-section bf-social"
  id="{{ section.settings.anchor_id | default: 'social' | handle }}"
  data-bf-social
>
  {% render 'bf-section-chrome', section: section %}

  <div class="bf-section__inner bf-social__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="bf-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="bf-section__body">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div class="bf-social__carousel">
    <button type="button" class="bf-social__nav bf-social__nav--prev" data-bf-social-prev aria-label="Previous">&#8249;</button>
    <div class="bf-social__track" data-bf-social-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'post' -%}
          <figure class="bf-social__item" {{ block.shopify_attributes }}>
            {%- render 'nf-media',
              video: block.settings.video,
              video_url: block.settings.video_url,
              image: block.settings.image,
              asset: block.settings.asset,
              alt: block.settings.caption,
              class: 'bf-social__media',
              sizes: '(min-width: 900px) 20vw, 70vw',
              loading: 'lazy'
            -%}
            {%- if block.settings.caption != blank -%}
              <figcaption>{{ block.settings.caption | escape }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <button type="button" class="bf-social__nav bf-social__nav--next" data-bf-social-next aria-label="Next">&#8250;</button>
  </div>
</section>

<script src="{{ 'bf-social-carousel.js' | asset_url }}" defer></script>

