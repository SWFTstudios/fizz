{% render 'bf-section-padding', section: section, horizontal_only: true %}
{% style %}
  /* bf-section-padding-apply */
  #shopify-section-{{ section.id }} .nf-header__inner {
    padding-inline: var(--bf-pad-x, var(--bf-page-pad-x, var(--nf-gutter)));
  }
{% endstyle %}

{%- liquid
  assign cart_count = cart.item_count
  assign bg_start = section.settings.bg_start | default: '#f4f3ee'
  assign bg_end = section.settings.bg_end | default: '#e9e7df'
  assign opacity_pct = section.settings.bg_opacity | default: 92
  assign opacity = opacity_pct | times: 1.0 | divided_by: 100.0
  assign text_color = section.settings.text_color | default: '#111214'
  assign text_color_over = section.settings.text_color_over_hero | default: '#ffffff'
  assign blur_enabled = section.settings.blur_background
  if blur_enabled == nil
    assign blur_enabled = true
  endif
  assign blur_amount = section.settings.blur_amount | default: 12
  assign gradient_angle = section.settings.gradient_angle | default: 180

  assign bg_start_a = bg_start | color_modify: 'alpha', opacity
  assign bg_end_a = bg_end | color_modify: 'alpha', opacity
  assign text_rgb = text_color | color_to_rgb | remove: 'rgb(' | remove: ')'
  assign text_over_rgb = text_color_over | color_to_rgb | remove: 'rgb(' | remove: ')'

  if blur_enabled
    assign blur_value = 'blur(' | append: blur_amount | append: 'px)'
  else
    assign blur_value = 'none'
  endif

  assign hdr_bg = 'linear-gradient(' | append: gradient_angle | append: 'deg, ' | append: bg_start_a | append: ', ' | append: bg_end_a | append: ')'

  assign menu_match = section.settings.menu_match_header
  if menu_match == nil
    assign menu_match = true
  endif

  if menu_match
    assign menu_bg = hdr_bg
    assign menu_blur_value = blur_value
    assign menu_blur_on = blur_enabled
  else
    assign menu_bg_start = section.settings.menu_bg_start | default: '#f4f3ee'
    assign menu_bg_end = section.settings.menu_bg_end | default: '#e9e7df'
    assign menu_opacity_pct = section.settings.menu_bg_opacity | default: 92
    assign menu_opacity = menu_opacity_pct | times: 1.0 | divided_by: 100.0
    assign menu_gradient_angle = section.settings.menu_gradient_angle | default: 180
    assign menu_blur_on = section.settings.menu_blur_background
    if menu_blur_on == nil
      assign menu_blur_on = true
    endif
    assign menu_blur_amount = section.settings.menu_blur_amount | default: 12
    assign menu_bg_start_a = menu_bg_start | color_modify: 'alpha', menu_opacity
    assign menu_bg_end_a = menu_bg_end | color_modify: 'alpha', menu_opacity
    assign menu_bg = 'linear-gradient(' | append: menu_gradient_angle | append: 'deg, ' | append: menu_bg_start_a | append: ', ' | append: menu_bg_end_a | append: ')'
    if menu_blur_on
      assign menu_blur_value = 'blur(' | append: menu_blur_amount | append: 'px)'
    else
      assign menu_blur_value = 'none'
    endif
  endif
-%}
<header
  class="nf-header{% if section.settings.transparent_home and template.name == 'index' %} nf-header--transparent{% endif %}{% if blur_enabled %} nf-header--blur{% endif %}{% if menu_match %} nf-header--menu-match{% endif %}{% if menu_blur_on %} nf-header--menu-blur{% endif %}"
  data-nf-header
  data-nf-transparent-home="{% if section.settings.transparent_home and template.name == 'index' %}true{% else %}false{% endif %}"
  style="
    --nf-hdr-bg: {{ hdr_bg }};
    --nf-hdr-text: {{ text_color }};
    --nf-hdr-text-rgb: {{ text_rgb }};
    --nf-hdr-text-over: {{ text_color_over }};
    --nf-hdr-text-over-rgb: {{ text_over_rgb }};
    --nf-hdr-blur: {{ blur_value }};
    --nf-hdr-opacity: {{ opacity }};
    --nf-menu-bg: {{ menu_bg }};
    --nf-menu-blur: {{ menu_blur_value }};
  "
>
  <div class="nf-header__inner">
    <a
      href="{{ routes.root_url }}"
      class="nf-header__logo{% if section.settings.logo != blank and section.settings.logo_white != blank %} nf-header__logo--dual{% endif %}"
      data-nf-over-media
      aria-label="{{ shop.name | escape }}"
    >
      {%- if section.settings.logo != blank and section.settings.logo_white != blank -%}
        {{
          section.settings.logo
          | image_url: width: 360
          | image_tag: class: 'nf-header__logo-img nf-header__logo-img--regular', widths: '120, 240, 360', sizes: '120px', alt: shop.name
        }}
        {{
          section.settings.logo_white
          | image_url: width: 360
          | image_tag: class: 'nf-header__logo-img nf-header__logo-img--white', widths: '120, 240, 360', sizes: '120px', alt: shop.name
        }}
      {%- elsif section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 360
          | image_tag: class: 'nf-header__logo-img', widths: '120, 240, 360', sizes: '120px', alt: shop.name
        }}
      {%- elsif section.settings.logo_white != blank -%}
        {{
          section.settings.logo_white
          | image_url: width: 360
          | image_tag: class: 'nf-header__logo-img', widths: '120, 240, 360', sizes: '120px', alt: shop.name
        }}
      {%- else -%}
        <span class="nf-header__logo-text">{{ section.settings.logo_text | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="nf-header__nav" id="nf-nav" aria-label="Main">
      <ul class="nf-header__list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign href = block.settings.url
            if block.settings.anchor_id != blank
              assign href = routes.root_url | append: '#' | append: block.settings.anchor_id
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            <a class="nf-header__link" data-nf-over-media href="{{ href | default: routes.root_url }}">{{ block.settings.label | escape }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="nf-header__actions">
      <a class="nf-header__cart" data-nf-over-media href="{{ routes.cart_url }}" aria-label="{{ 'cart.general.title' | t }}">
        <svg class="nf-header__cart-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 7h12l-1.2 12.2a1.5 1.5 0 0 1-1.5 1.3H8.7a1.5 1.5 0 0 1-1.5-1.3L6 7Z"/>
          <path d="M9 9V6a3 3 0 1 1 6 0v3"/>
        </svg>
        <span class="nf-header__cart-count" data-nf-cart-count>{{ cart_count }}</span>
      </a>
      <button
        class="nf-header__toggle"
        data-nf-over-media
        type="button"
        aria-expanded="false"
        aria-controls="nf-nav"
        data-nf-menu-toggle
      >
        <span class="nf-header__toggle-bar"></span>
        <span class="nf-header__toggle-bar"></span>
        <span class="nf-visually-hidden">{{ section.settings.menu_label | default: 'Menu' }}</span>
      </button>
    </div>
  </div>
</header>

<script>
  (function () {
    var header = document.querySelector('[data-nf-header]');
    if (!header) return;
    var toggle = header.querySelector('[data-nf-menu-toggle]');

    function setNavTop() {
      var h = Math.round(header.offsetHeight) || 56;
      document.documentElement.style.setProperty('--nf-nav-top', h + 'px');
    }

    if (toggle) {
      toggle.addEventListener('click', function () {
        var open = header.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.documentElement.classList.toggle('nf-menu-open', open);
        setNavTop();
      });
      header.querySelectorAll('.nf-header__link').forEach(function (link) {
        link.addEventListener('click', function () {
          header.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
          document.documentElement.classList.remove('nf-menu-open');
          setNavTop();
        });
      });
    }

    setNavTop();
    window.addEventListener('resize', setNavTop);

    var transparentHome = header.getAttribute('data-nf-transparent-home') === 'true';
    var heroPast = !transparentHome;
    var heroIOPast = false;
    var heardHeroEvent = false;
    var overItems = header.querySelectorAll('[data-nf-over-media]');
    var raf = 0;

    function syncScrolled() {
      var solid = !transparentHome || heroPast || heroIOPast;
      header.classList.toggle('is-scrolled', solid);
      syncOverMedia();
    }

    function rectsOverlap(a, b) {
      return !(
        a.right < b.left ||
        a.left > b.right ||
        a.bottom < b.top ||
        a.top > b.bottom
      );
    }

    function parseInset(clip, stageRect) {
      if (!clip || clip === 'none') return null;
      var match = String(clip).match(/inset\(\s*([^)]+)\)/i);
      if (!match) return null;
      var raw = match[1].split(/round/i)[0].trim().split(/\s+/);
      var vals = raw.map(function (part) {
        if (part.indexOf('%') !== -1) {
          return (parseFloat(part) / 100) * stageRect.height;
        }
        return parseFloat(part) || 0;
      });
      var top;
      var right;
      var bottom;
      var left;
      if (vals.length === 1) {
        top = right = bottom = left = vals[0];
      } else if (vals.length === 2) {
        top = bottom = vals[0];
        right = left = vals[1];
      } else if (vals.length === 3) {
        top = vals[0];
        right = left = vals[1];
        bottom = vals[2];
      } else {
        top = vals[0];
        right = vals[1];
        bottom = vals[2];
        left = vals[3];
      }
      return {
        top: stageRect.top + top,
        right: stageRect.right - right,
        bottom: stageRect.bottom - bottom,
        left: stageRect.left + left
      };
    }

    function getVisibleMediaRect() {
      var stage = document.querySelector('[data-nf-hero-stage]');
      var media = document.querySelector('[data-nf-hero-media]');
      var frame = document.querySelector('[data-nf-hero-frame]');
      if (!stage || !media) return null;
      var stageRect = stage.getBoundingClientRect();
      var clip =
        getComputedStyle(media).clipPath ||
        getComputedStyle(media).webkitClipPath;
      var insetRect = parseInset(clip, stageRect);
      if (insetRect) return insetRect;
      var hero = document.querySelector('[data-nf-hero]');
      if (hero && (hero.classList.contains('is-shrunk') || hero.classList.contains('is-static-inset')) && frame) {
        return frame.getBoundingClientRect();
      }
      return media.getBoundingClientRect();
    }

    function syncOverMedia() {
      if (!overItems.length) return;
      var solid =
        !transparentHome ||
        header.classList.contains('is-scrolled') ||
        header.classList.contains('is-open');
      var mediaRect = solid ? null : getVisibleMediaRect();
      overItems.forEach(function (el) {
        if (!mediaRect) {
          el.classList.remove('is-over-media');
          return;
        }
        el.classList.toggle('is-over-media', rectsOverlap(el.getBoundingClientRect(), mediaRect));
      });
      header.classList.add('is-media-aware');
    }

    function scheduleOverMedia() {
      if (raf) return;
      raf = requestAnimationFrame(function () {
        raf = 0;
        syncOverMedia();
      });
    }

    if (!transparentHome) {
      syncScrolled();
      return;
    }

    document.addEventListener('nf:hero-chrome', function (e) {
      heardHeroEvent = true;
      heroPast = !(e.detail && e.detail.overHero);
      syncScrolled();
    });

    var hero = document.querySelector('[data-nf-hero]');
    if (hero) {
      if (hero.classList.contains('is-shrunk')) {
        heroPast = true;
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(
          function (entries) {
            var entry = entries[0];
            if (!entry) return;
            heroIOPast = entry.boundingClientRect.bottom <= 0;
            if (!heardHeroEvent) {
              heroPast = hero.classList.contains('is-shrunk') || heroIOPast;
            }
            syncScrolled();
          },
          { root: null, threshold: 0, rootMargin: '0px' }
        );
        io.observe(hero);
      }
    } else {
      heroPast = true;
    }

    window.addEventListener('scroll', scheduleOverMedia, { passive: true });
    window.addEventListener('resize', scheduleOverMedia);
    syncScrolled();
    scheduleOverMedia();
  })();
</script>

{% schema %}
{
  "name": "NF Header",
  "tag": "header",
  "class": "nf-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "image_picker",
      "id": "logo_white",
      "label": "Logo over hero / white",
      "info": "Shown while the header sits over homepage hero media. Switches back to the regular logo after scroll."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "info": "Used when no logo image is set. Defaults to the store name."
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Mobile menu label",
      "default": "Menu"
    },
    {
      "type": "checkbox",
      "id": "transparent_home",
      "label": "Transparent over homepage hero",
      "default": true,
      "info": "Header stays clear with over-hero text color while the hero media is fullscreen. After the hero shrinks or scrolls away, the sticky bar uses the colors below."
    },
    {
      "type": "color",
      "id": "text_color_over_hero",
      "label": "Text & icon color over hero",
      "default": "#ffffff",
      "info": "Used while the homepage hero media is fullscreen."
    },
    {
      "type": "header",
      "content": "Sticky header bar"
    },
    {
      "type": "paragraph",
      "content": "Styles the fixed top nav bar after scrolling past the hero (and on non-homepage templates)."
    },
    {
      "type": "color",
      "id": "bg_start",
      "label": "Gradient start",
      "default": "#f4f3ee"
    },
    {
      "type": "color",
      "id": "bg_end",
      "label": "Gradient end",
      "default": "#e9e7df"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "deg",
      "default": 180
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 92
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & icon color",
      "default": "#111214"
    },
    {
      "type": "checkbox",
      "id": "blur_background",
      "label": "Blur background",
      "default": true,
      "info": "Applies backdrop blur behind the sticky header bar."
    },
    {
      "type": "range",
      "id": "blur_amount",
      "label": "Blur strength",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Mobile dropdown menu"
    },
    {
      "type": "paragraph",
      "content": "When matching is on, the open menu shares the header background so they read as one panel. Turn matching off to style the dropdown independently."
    },
    {
      "type": "checkbox",
      "id": "menu_match_header",
      "label": "Mobile menu matches header background",
      "default": true
    },
    {
      "type": "color",
      "id": "menu_bg_start",
      "label": "Menu gradient start",
      "default": "#f4f3ee",
      "visible_if": "{{ section.settings.menu_match_header == false }}"
    },
    {
      "type": "color",
      "id": "menu_bg_end",
      "label": "Menu gradient end",
      "default": "#e9e7df",
      "visible_if": "{{ section.settings.menu_match_header == false }}"
    },
    {
      "type": "range",
      "id": "menu_gradient_angle",
      "label": "Menu gradient angle",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "deg",
      "default": 180,
      "visible_if": "{{ section.settings.menu_match_header == false }}"
    },
    {
      "type": "range",
      "id": "menu_bg_opacity",
      "label": "Menu background opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 92,
      "visible_if": "{{ section.settings.menu_match_header == false }}"
    },
    {
      "type": "checkbox",
      "id": "menu_blur_background",
      "label": "Menu blur background",
      "default": true,
      "visible_if": "{{ section.settings.menu_match_header == false }}"
    },
    {
      "type": "range",
      "id": "menu_blur_amount",
      "label": "Menu blur strength",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.menu_match_header == false }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "use_theme_spacing",
      "label": "Use global padding",
      "info": "Uses Theme settings \u2192 Layout for desktop and mobile padding. Turn off to set unique padding below.",
      "default": true
