{% render 'bf-section-padding', section: section %}
{% style %}
  /* bf-section-padding-apply */
  #shopify-section-{{ section.id }} .nf-about__story {
    padding-block: var(--bf-pad-top, 0) var(--bf-pad-bottom, 0);
    padding-inline: var(--bf-pad-x, var(--bf-page-pad-x, 0));
  }
{% endstyle %}

<section class="nf-about" id="{{ section.settings.anchor_id | default: 'about' }}">
  <div class="nf-about__story">
    <div class="nf-about__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="nf-heading nf-about__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="nf-about__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        {%- assign about_cta_url = section.settings.cta_url | default: routes.root_url -%}
        {% render 'nf-button',
          label: section.settings.cta_label,
          url: about_cta_url,
          style: section.settings.button_style
        %}
      {%- endif -%}
    </div>
    <div class="nf-about__media">
      {%- render 'nf-media',
        video: section.settings.video,
        image: section.settings.image,
        asset: section.settings.asset,
        alt: section.settings.heading,
        class: 'nf-about__img',
        sizes: '(min-width: 750px) 45vw, 100vw'
      -%}
    </div>
  </div>
</section>

