{% render 'bf-section-padding', section: section %}
{% style %}
  /* bf-section-padding-apply */
  #shopify-section-{{ section.id }} .nf-password__panel {
    padding-block: var(--bf-pad-top, 0) var(--bf-pad-bottom, 0);
    padding-inline: var(--bf-pad-x, var(--bf-page-pad-x, 0));
  }
{% endstyle %}

<section class="nf-password__panel">
  <h1 class="nf-password__title">{{ shop.name }}</h1>
  <p class="nf-password__note">{{ section.settings.note | default: 'Opening soon' | escape }}</p>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <label class="nf-visually-hidden" for="Password">{{ 'general.password_page.password_label' | t }}</label>
    <input
      type="password"
      name="password"
      id="Password"
      class="nf-input"
      placeholder="{{ 'general.password_page.password_label' | t }}"
    >
    <button type="submit" class="nf-btn">{{ 'general.password_page.enter' | t }}</button>
  {% endform %}
</section>

{% schema %}
