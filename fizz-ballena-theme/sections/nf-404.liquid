{% render 'bf-section-padding', section: section %}
{% style %}
  /* bf-section-padding-apply */
  #shopify-section-{{ section.id }} .nf-404 {
    padding-block: var(--bf-pad-top, 0) var(--bf-pad-bottom, 0);
    padding-inline: var(--bf-pad-x, var(--bf-page-pad-x, 0));
  }
{% endstyle %}

<section class="nf-404">
  <p class="nf-eyebrow">404</p>
  <h1 class="nf-heading nf-404__title">{{ section.settings.heading | default: 'Page not found' | escape }}</h1>
  <p class="nf-404__text">{{ section.settings.subtext | default: 'The page you were looking for has fizzed away.' | escape }}</p>
  <a class="nf-btn nf-btn--accent" href="{{ routes.root_url }}">{{ section.settings.link_label | default: 'Back to home' | escape }}</a>
</section>

{% schema %}
{
  "name": "NF 404",
  "tag": "section",
  "class": "nf-404-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
