{% render 'bf-section-padding', section: section %}
{% style %}
  /* bf-section-padding-apply */
  #shopify-section-{{ section.id }} .nf-product {
    padding-block: var(--bf-pad-top, 0) var(--bf-pad-bottom, 0);
    padding-inline: var(--bf-pad-x, var(--bf-page-pad-x, 0));
  }
  {%- if section.settings.dark_surface -%}
  #shopify-section-{{ section.id }} {
    background: var(--nf-dark);
    color: var(--nf-dark-text);
  }
  {%- endif -%}
{% endstyle %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  capture color_slug
    render 'nf-color-slug', variant: current_variant
  endcapture
  assign color_slug = color_slug | strip
  capture scene_raw
    render 'nf-colorway-scene', slug: color_slug, variant: current_variant
  endcapture
  assign scene_parts = scene_raw | strip | split: '|'
  assign stage_bg = scene_parts[0] | default: settings.color_surface
  assign stage_bg_end = scene_parts[1] | default: settings.color_dark
  assign stage_text = scene_parts[3] | default: settings.color_dark_text

  assign media_fit = section.settings.media_fit | default: 'cover'
  assign gallery_mode = section.settings.gallery_mode | default: 'slider'
  assign desktop_layout = section.settings.desktop_layout | default: 'side'
  assign mobile_ratio = section.settings.mobile_media_ratio | default: '4 / 5'
  assign show_thumbs = section.settings.show_thumbnails
  if show_thumbs == nil
    assign show_thumbs = true
  endif
  assign thumbs_mobile = section.settings.thumbnails_on_mobile
  if thumbs_mobile == nil
    assign thumbs_mobile = false
  endif
  assign show_arrows = section.settings.show_arrows
  if show_arrows == nil
    assign show_arrows = true
  endif
  assign media_count = product.media.size
  assign badge_label = section.settings.badge_label
  if badge_label == blank and product.tags contains 'bestseller'
    assign badge_label = 'Bestseller'
  endif
  assign enable_lightbox = section.settings.enable_lightbox
  if enable_lightbox == nil
    assign enable_lightbox = true
  endif
  assign dark_surface = section.settings.dark_surface
  if dark_surface == nil
    assign dark_surface = true
  endif
  assign lightbox_index = -1
  assign thumb_ratio = section.settings.thumb_media_ratio | default: '1 / 1'
  assign thumb_radius = section.settings.thumb_corner_radius | default: 10
-%}
<section
  class="nf-product nf-product--soft nf-product--fit-{{ media_fit }} nf-product--gallery-{{ gallery_mode }} nf-product--layout-{{ desktop_layout }}{% if show_thumbs %} nf-product--thumbs{% endif %}{% if thumbs_mobile %} nf-product--thumbs-mobile{% endif %}{% if dark_surface %} nf-product--dark{% endif %}{% if enable_lightbox %} nf-product--lightbox{% endif %}"
  data-nf-product
  data-gallery-mode="{{ gallery_mode }}"
  data-enable-lightbox="{{ enable_lightbox }}"
  data-stage-mode="{{ section.settings.stage_mode }}"
  style="
    --pdp-stage-bg: {{ stage_bg }};
    --pdp-stage-bg-end: {{ stage_bg_end }};
    --pdp-stage-text: {{ stage_text }};
    --nf-pdp-media-ratio: {{ mobile_ratio }};
    --nf-pdp-thumb-ratio: {{ thumb_ratio }};
    --nf-pdp-thumb-radius: {{ thumb_radius }}px;
  "
>
  <div class="nf-product__layout">
    <div class="nf-product__gallery">
      <div
        class="nf-product__stage nf-product__stage--{{ section.settings.stage_mode }}"
        data-nf-pdp-stage
      >
        <div class="nf-product__media-rail" data-nf-media-rail>
          {%- if media_count > 0 -%}
            {%- for media in product.media -%}
              {%- liquid
                if media.media_type == 'image'
                  assign lightbox_index = lightbox_index | plus: 1
                endif
              -%}
              <div
                class="nf-product__media{% if forloop.first %} is-active{% endif %}"
                data-media-id="{{ media.id }}"
                data-media-index="{{ forloop.index0 }}"
                data-media-type="{{ media.media_type }}"
                {% if media.media_type == 'image' %}data-lightbox-index="{{ lightbox_index }}"{% endif %}
              >
                {%- case media.media_type -%}
                  {%- when 'video' -%}
                    <span class="nf-product__media-badge" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M4 3.5v9l8-4.5-8-4.5z"/></svg>
                    </span>
                    {{ media | video_tag: image_size: '1080x', controls: true, playsinline: true, class: 'nf-product__media-el' }}
                  {%- when 'external_video' -%}
                    <span class="nf-product__media-badge" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M4 3.5v9l8-4.5-8-4.5z"/></svg>
                    </span>
                    {{ media | external_video_tag: class: 'nf-product__media-el' }}
                  {%- when 'model' -%}
                    <span class="nf-product__media-badge nf-product__media-badge--model" aria-hidden="true">3D</span>
                    {{ media | model_viewer_tag: class: 'nf-product__media-el' }}
                  {%- else -%}
                    {%- liquid
                      assign media_loading = 'lazy'
                      if forloop.first
                        assign media_loading = 'eager'
                      endif
                      assign focal = media.preview_image.presentation.focal_point | default: 'center'
                      assign media_style = 'object-position: ' | append: focal
                    -%}
                    {%- if enable_lightbox -%}
                      <button
                        type="button"
                        class="nf-product__zoom"
                        data-nf-lightbox-open
                        data-lightbox-index="{{ lightbox_index }}"
                        aria-label="{{ 'products.product.zoom' | t: index: forloop.index }}"
                      >
                        {{
                          media
                          | image_url: width: 1400
                          | image_tag:
                            class: 'nf-product__media-el',
                            loading: media_loading,
                            sizes: '(min-width: 750px) 55vw, 100vw',
                            widths: '540, 720, 1080, 1400',
                            alt: media.alt,
                            style: media_style
                        }}
                      </button>
                    {%- else -%}
                      {{
                        media
                        | image_url: width: 1400
                        | image_tag:
                          class: 'nf-product__media-el',
                          loading: media_loading,
                          sizes: '(min-width: 750px) 55vw, 100vw',
                          widths: '540, 720, 1080, 1400',
                          alt: media.alt,
                          style: media_style
                      }}
                    {%- endif -%}
                  {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="nf-product__media is-active" data-media-id="fallback" data-media-index="0">
              <img
                src="{{ 'fizz-bottle-product-' | append: color_slug | append: '.png' | asset_url }}"
                class="nf-product__media-el nf-product__media-el--contain"
                width="504"
                height="1400"
                alt="{{ product.title | escape }}"
                data-nf-fallback-bottle
              >
            </div>
          {%- endif -%}
        </div>

        {%- if gallery_mode == 'slider' and show_arrows and media_count > 1 -%}
          <button type="button" class="nf-product__arrow nf-product__arrow--prev" data-nf-gallery-prev aria-label="{{ 'general.accessibility.previous' | t }}">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M11 4L6 9l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="nf-product__arrow nf-product__arrow--next" data-nf-gallery-next aria-label="{{ 'general.accessibility.next' | t }}">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M7 4l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}
      </div>

      {%- if media_count > 1 -%}
        {%- if show_thumbs -%}
          <div class="nf-product__thumbs" data-nf-thumbs>
            {%- for media in product.media -%}
              <button
                type="button"
                class="nf-product__thumb{% if forloop.first %} is-active{% endif %}"
                data-nf-thumb
                data-media-id="{{ media.id }}"
                data-media-index="{{ forloop.index0 }}"
                aria-label="{{ 'products.product.media_label' | t: index: forloop.index }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="nf-product__dots" data-nf-gallery-dots role="tablist" aria-label="Gallery slides">
          {%- for media in product.media -%}
            <button
              type="button"
              class="nf-product__dot{% if forloop.first %} is-active{% endif %}"
              data-nf-dot
              data-media-id="{{ media.id }}"
              data-media-index="{{ forloop.index0 }}"
              aria-label="Go to image {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if enable_lightbox and lightbox_index >= 0 -%}
        <dialog
          class="nf-product-lightbox"
          data-nf-lightbox
          data-lightbox-group="product-{{ product.id }}"
          aria-label="{{ 'products.product.lightbox' | t }}"
        >
          <button type="button" class="nf-product-lightbox__close" data-nf-lightbox-close aria-label="{{ 'general.accessibility.close' | t }}">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
          </button>
          {%- if lightbox_index > 0 -%}
            <button type="button" class="nf-product-lightbox__arrow nf-product-lightbox__arrow--prev" data-nf-lightbox-prev aria-label="{{ 'general.accessibility.previous' | t }}">
              <svg width="22" height="22" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M11 4L6 9l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="nf-product-lightbox__arrow nf-product-lightbox__arrow--next" data-nf-lightbox-next aria-label="{{ 'general.accessibility.next' | t }}">
              <svg width="22" height="22" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M7 4l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {%- endif -%}
          <div class="nf-product-lightbox__viewport">
            {%- assign lb_idx = -1 -%}
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                {%- assign lb_idx = lb_idx | plus: 1 -%}
                <figure
                  class="nf-product-lightbox__slide{% if lb_idx == 0 %} is-active{% endif %}"
                  data-nf-lightbox-slide
                  data-lightbox-index="{{ lb_idx }}"
                  {% unless lb_idx == 0 %}hidden{% endunless %}
                >
                  {{
                    media
                    | image_url: width: 2048
                    | image_tag:
                      class: 'nf-product-lightbox__img',
                      loading: 'lazy',
                      sizes: '100vw',
                      widths: '1080, 1440, 2048',
                      alt: media.alt
                  }}
                </figure>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <p class="nf-product-lightbox__counter" data-nf-lightbox-counter aria-live="polite">
            {{ 'products.product.slide_of' | t: current: 1, total: lightbox_index | plus: 1 }}
          </p>
        </dialog>
      {%- endif -%}
    </div>

    <div class="nf-product__panel">
      <nav class="nf-product__crumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ shop.name }}</a>
        {%- if collection -%}
          <span aria-hidden="true">/</span>
          <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
        {%- endif -%}
        <span aria-hidden="true">/</span>
        <span>{{ product.title | escape }}</span>
      </nav>

      {%- if section.settings.eyebrow != blank -%}
        <p class="nf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- elsif section.settings.show_vendor and product.vendor != blank -%}
        <p class="nf-eyebrow">{{ product.vendor | escape }}</p>
      {%- endif -%}

      <div class="nf-product__heading-row">
        <div class="nf-product__heading-main">
          <h1 class="nf-heading nf-product__title">{{ section.settings.heading | default: product.title | escape }}</h1>
          {%- if badge_label != blank -%}
            <span class="nf-product__badge">{{ badge_label | escape }}</span>
          {%- endif -%}
        </div>
        <p class="nf-product__price" data-nf-price>
          <span data-nf-price-current>{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s data-nf-price-compare>{{ current_variant.compare_at_price | money }}</s>
          {%- else -%}
            <s data-nf-price-compare hidden></s>
          {%- endif -%}
        </p>
      </div>

      {%- if section.settings.tagline != blank -%}
        <p class="nf-product__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}

      {% form 'product', product, class: 'nf-product__form', novalidate: 'novalidate' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-nf-variant-id>

        {%- if product.variants.size > 1 and section.settings.show_colorway_swatches -%}
          <div class="nf-product__ways" data-nf-ways>
            <p class="nf-product__option-name">
              {{ section.settings.colorway_label | default: 'Colorway' | escape }}
              — <span data-nf-way-label>{{ current_variant.title | escape }}</span>
            </p>
            <div class="nf-product__swatches" role="list">
              {%- for variant in product.variants -%}
                {%- capture slug -%}{% render 'nf-color-slug', variant: variant %}{%- endcapture -%}
                {%- assign slug = slug | strip -%}
                {%- capture scene -%}{% render 'nf-colorway-scene', slug: slug, variant: variant %}{%- endcapture -%}
                {%- assign swatch_parts = scene | strip | split: '|' -%}
                {%- assign swatch_hex = swatch_parts[4] -%}
                <button
                  type="button"
                  class="nf-swatch{% if variant.id == current_variant.id %} is-active{% endif %}"
                  data-nf-swatch
                  data-variant-id="{{ variant.id }}"
                  data-options="{{ variant.options | json | escape }}"
                  data-name="{{ variant.title | escape }}"
                  data-bg="{{ swatch_parts[0] }}"
                  data-bg-end="{{ swatch_parts[1] }}"
                  data-text="{{ swatch_parts[3] }}"
                  data-available="{{ variant.available }}"
                  data-price="{{ variant.price }}"
                  data-compare="{{ variant.compare_at_price | default: 0 }}"
                  data-media-id="{{ variant.featured_media.id }}"
                  data-fallback-src="{{ 'fizz-bottle-product-' | append: slug | append: '.png' | asset_url }}"
                  style="--swatch: {{ swatch_hex }};"
                  aria-label="{{ variant.title | escape }}"
                  title="{{ variant.title | escape }}"
                ></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- unless product.has_only_default_variant -%}
          {%- unless section.settings.show_colorway_swatches and product.options.size == 1 -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="nf-product__option" data-nf-option data-option-index="{{ forloop.index0 }}">
                <legend class="nf-product__option-name">{{ option.name | escape }}</legend>
                <div class="nf-product__pills">
                  {%- for value in option.values -%}
                    <label class="nf-pill">
                      <input
                        type="radio"
                        name="option-{{ section.id }}-{{ forloop.parentloop.index0 }}"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                        data-nf-option-input
                      >
                      <span>{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}
        {%- endunless -%}

        {%- if section.settings.show_quantity -%}
          <div class="nf-product__qty-wrap">
            <label class="nf-product__qty-label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
            <div class="nf-stepper" data-nf-stepper>
              <button
                type="button"
                class="nf-stepper__btn"
                data-nf-stepper-dec
                aria-label="{{ 'products.product.quantity_decrease' | t }}"
              >
                −
              </button>
              <input
                id="Quantity-{{ section.id }}"
                class="nf-input nf-product__qty nf-stepper__input"
                type="number"
                name="quantity"
                value="1"
                min="1"
                data-nf-qty
              >
              <button
                type="button"
                class="nf-stepper__btn"
                data-nf-stepper-inc
                aria-label="{{ 'products.product.quantity_increase' | t }}"
              >
                +
              </button>
            </div>
          </div>
        {%- endif -%}

        <button
          type="submit"
          name="add"
          class="nf-btn nf-btn--accent nf-product__atc"
          data-nf-atc
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span data-nf-atc-label>
            {%- if current_variant.available -%}
              {{ section.settings.atc_label | default: 'Add to cart' | escape }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>
        </button>
        {%- if section.settings.show_dynamic_checkout -%}
          {{ form | payment_button }}
        {%- endif -%}
      {% endform %}

      {%- assign has_feature = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}{%- assign has_feature = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_feature -%}
        <ul class="nf-product__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <li class="nf-product__feature" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <span class="nf-product__feature-icon">
                    {{
                      block.settings.icon
                      | image_url: width: 96
                      | image_tag: loading: 'lazy', widths: '48, 96', sizes: '40px', alt: ''
                    }}
                  </span>
                {%- else -%}
                  <span class="nf-product__feature-icon nf-product__feature-icon--mark" aria-hidden="true"></span>
                {%- endif -%}
                <span class="nf-product__feature-label">{{ block.settings.label | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- assign has_trust = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust' -%}{%- assign has_trust = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_trust -%}
        <ul class="nf-product__trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust' -%}
              <li {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- liquid
        assign show_product_description = false
        if section.settings.show_description and product.description != blank
          assign show_product_description = true
        endif
        assign has_accordion_blocks = false
        for block in section.blocks
          if block.type == 'accordion'
            assign has_accordion_blocks = true
          endif
        endfor
        assign description_heading = section.settings.description_heading
        if description_heading == blank
          assign description_heading = 'products.product.description' | t
        endif
      -%}
      {%- if show_product_description or has_accordion_blocks -%}
        <div class="nf-product__accordions">
          {%- if show_product_description -%}
            <details class="nf-accordion" open>
              <summary class="nf-accordion__summary">{{ description_heading | escape }}</summary>
              <div class="nf-accordion__body nf-rte">{{ product.description }}</div>
            </details>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <details class="nf-accordion" {{ block.shopify_attributes }}>
                <summary class="nf-accordion__summary">{{ block.settings.title | escape }}</summary>
                <div class="nf-accordion__body">
                  {%- if block.settings.image != blank -%}
                    <div class="nf-accordion__media">
                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'nf-accordion__img',
                          loading: 'lazy',
                          widths: '480, 720, 960, 1200',
                          sizes: '(min-width: 750px) 40vw, 92vw',
                          alt: block.settings.image.alt
                      }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.body != blank -%}
                    <div class="nf-rte">{{ block.settings.body }}</div>
                  {%- endif -%}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script type="application/json" data-nf-product-json>
  {{ product.variants | json }}
</script>
<script type="application/json" data-nf-product-config>
  {
    "moneyFormat": {{ shop.money_format | json }},
    "soldOutText": {{ 'products.product.sold_out' | t | json }},
    "addText": {{ section.settings.atc_label | default: 'Add to cart' | json }},
    "unavailableText": {{ 'products.product.unavailable' | t | json }},
    "enableLightbox": {{ enable_lightbox | json }},
    "galleryMode": {{ gallery_mode | json }},
    "slideOfTemplate": {{ 'products.product.slide_of' | t | json }}
  }
</script>
<script src="{{ 'nf-product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "NF Product",
  "tag": "section",
  "class": "nf-product-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Sparkling water, anywhere."
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "Bestseller",
      "info": "Shown next to the title. Leave blank to hide (or use a product tag named bestseller)."
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "options": [
        { "value": "cover", "label": "Cover (fill stage)" },
        { "value": "contain", "label": "Contain (packshot)" }
      ],
      "default": "cover",
      "info": "Cover fills lifestyle photos. Use Contain for studio bottle cutouts that must not crop."
    },
    {
      "type": "select",
      "id": "gallery_mode",
      "label": "Gallery mode",
      "options": [
        { "value": "slider", "label": "Slider (swipe)" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show thumbnails",
      "default": true
    },
    {
      "type": "select",
      "id": "thumb_media_ratio",
      "label": "Thumbnail aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square 1:1" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "4 / 3", "label": "Landscape 4:3" }
      ],
      "default": "1 / 1",
