{% render 'bf-section-padding', section: section %}
{% style %}
  /* bf-section-padding-apply */
  #shopify-section-{{ section.id }} .nf-related {
    padding-block: var(--bf-pad-top, 0) var(--bf-pad-bottom, 0);
    padding-inline: var(--bf-pad-x, var(--bf-page-pad-x, 0));
  }
{% endstyle %}

{%- if recommendations.performed? -%}
  {%- assign related_products = recommendations.products -%}
{%- else -%}
  {%- assign related_products = collections.all.products | slice: 0, section.settings.limit -%}
{%- endif -%}

{%- liquid
  assign media_fit = section.settings.media_fit | default: 'cover'
  assign media_ratio = section.settings.media_ratio | default: '4 / 5'
  if media_fit == 'cover' and media_ratio == 'auto'
    assign media_ratio = '4 / 5'
  endif
-%}

<section class="nf-related nf-related--fit-{{ media_fit }}">
  <h2 class="nf-heading nf-related__heading">{{ section.settings.heading | escape }}</h2>
  <div
    class="nf-related__rail"
    data-recommendations
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}"
  >
    {%- for related in related_products limit: section.settings.limit -%}
      {%- unless related.id == product.id -%}
        {% render 'nf-product-card',
          product: related,
          show_swatches: true,
          show_quick_add: false,
          media_ratio: media_ratio,
          media_fit: media_fit
        %}
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    var wrap = document.querySelector('[data-recommendations]');
    if (!wrap || !wrap.dataset.url) return;
    fetch(wrap.dataset.url)
      .then(function (res) { return res.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.querySelector('[data-recommendations]');
        if (fresh && fresh.children.length) wrap.innerHTML = fresh.innerHTML;
      })
      .catch(function () {});
  })();
</script>

