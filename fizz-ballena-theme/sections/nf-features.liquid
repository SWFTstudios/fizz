{% render 'bf-section-padding', section: section %}
{% comment %} Vertical pad lives on .nf-features-section (wrapper) via nf-neofizz.css + --bf-pad-* {% endcomment %}

<section
  class="nf-features"
  id="{{ section.settings.anchor_id | default: 'features' | handle }}"
  data-nf-features
  data-nf-reveal
>
  <div class="nf-container">
    <div class="nf-features__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="nf-heading nf-features__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="nf-features__layout">
      <div class="nf-features__media" data-nf-features-media>
        {%- for block in section.blocks -%}
          <figure
            class="nf-features__layer{% if forloop.first %} is-active{% endif %}"
            data-nf-features-layer
            {{ block.shopify_attributes }}
          >
            {%- render 'nf-media',
              video: block.settings.video,
              image: block.settings.image,
              asset: block.settings.asset,
              alt: block.settings.title,
              class: 'nf-features__img',
              sizes: '(min-width: 750px) 48vw, 100vw'
            -%}
          </figure>
        {%- endfor -%}
      </div>

      <div class="nf-features__cards" data-nf-features-cards>
        {%- for block in section.blocks -%}
          <article
            class="nf-features__card{% if forloop.first %} is-active{% endif %}"
            data-nf-features-card
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <div class="nf-features__card-top">
              {%- if block.settings.tag != blank -%}
                <span class="nf-features__tag">{{ block.settings.tag | escape }}</span>
              {%- endif -%}
              <span class="nf-features__dots" aria-hidden="true">
                {%- for i in (1..9) -%}
                  <i class="{% if i <= block.settings.dot_count %}is-on{% endif %}"></i>
                {%- endfor -%}
              </span>
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="nf-features__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="nf-rte nf-features__body">{{ block.settings.body }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              {% render 'nf-button',
                label: block.settings.button_label,
                url: block.settings.button_link,
                style: block.settings.button_style,
                class: 'nf-features__cta'
              %}
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

