{{ 'bf-benefits.css' | asset_url | stylesheet_tag }}
<section
  class="bf-section bf-benefits"
  id="{{ section.settings.anchor_id | default: 'benefits' | handle }}"
>
  {% render 'bf-section-chrome', section: section %}

  <div class="bf-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="bf-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="bf-section__body">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="bf-benefits__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          <article
            class="bf-benefits__card{% if forloop.index == 5 %} bf-benefits__card--wide{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank or block.settings.asset != blank -%}
              <div class="bf-benefits__media">
                {%- render 'nf-media',
                  image: block.settings.image,
                  asset: block.settings.asset,
                  alt: block.settings.title,
                  class: 'bf-benefits__img',
                  sizes: '(min-width: 900px) 30vw, 90vw',
                  loading: 'lazy'
                -%}
              </div>
            {%- endif -%}
            <div class="bf-benefits__copy">
              <p class="bf-benefits__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
              <h3 class="bf-benefits__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.body != blank -%}
                <p class="bf-benefits__body">{{ block.settings.body | escape }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

