{% render 'bf-section-padding', section: section %}
{% style %}
  /* bf-section-padding-apply */
  {%- if section.settings.use_theme_spacing -%}
    #shopify-section-{{ section.id }} .nf-collection {
      --nf-collection-pad-y: var(--bf-pad-top, {{ section.settings.padding_y | default: 48 }}px);
    }
  {%- endif -%}
  #shopify-section-{{ section.id }} .nf-collection__body {
    padding-inline: var(--bf-pad-x, var(--bf-page-pad-x, var(--nf-gutter)));
  }
{% endstyle %}

{%- comment -%}
  Collection page — hero, editorial benefits, product grid.
  Surfaces + type inherit active Theme style / colorway tokens.
{%- endcomment -%}

{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 12
  assign hero_mode = section.settings.hero_mode | default: 'surface'
  assign card_media_fit = section.settings.card_media_fit | default: 'cover'
  assign card_ratio = section.settings.card_media_ratio | default: '4 / 5'
  if card_media_fit == 'cover' and card_ratio == 'auto'
    assign card_ratio = '4 / 5'
  endif
-%}

<section
  class="nf-collection"
  data-nf-collection
  style="
    {%- unless section.settings.use_theme_spacing -%}
      --nf-collection-pad-y: {{ section.settings.padding_y }}px;
    {%- endunless -%}
    --nf-collection-gap: {{ section.settings.grid_gap }}px;
    --nf-collection-hero-min: {{ section.settings.hero_min_height }}vh;
  "
>
  <header class="nf-collection__hero nf-collection__hero--{{ hero_mode }}">
    <div class="nf-collection__hero-bg" aria-hidden="true">
      <span class="nf-collection__hero-wash"></span>
      <span class="nf-collection__hero-grain"></span>
    </div>
    <div class="nf-collection__hero-inner nf-container">
      {%- if section.settings.show_breadcrumb -%}
        <nav class="nf-collection__crumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">{{ 'general.home' | t | default: 'Home' }}</a>
          <span aria-hidden="true">/</span>
          <span>{{ collection.title | escape }}</span>
        </nav>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="nf-collection__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="nf-collection__title">{{ collection.title | escape }}</h1>

      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="nf-collection__desc rte">{{ collection.description }}</div>
      {%- elsif section.settings.fallback_description != blank -%}
        <p class="nf-collection__desc">{{ section.settings.fallback_description | escape }}</p>
      {%- endif -%}

      {%- if section.settings.show_count -%}
        <p class="nf-collection__count">
          {{ collection.products_count }}
          {%- if collection.products_count == 1 -%} product{%- else -%} products{%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </header>

  {%- if section.blocks.size > 0 -%}
    <div class="nf-collection__benefits nf-container">
      <ul class="nf-collection__benefit-list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <li class="nf-collection__benefit" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <p class="nf-collection__benefit-label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="nf-collection__benefit-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  <div class="nf-collection__body nf-container">
    {%- paginate collection.products by products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="nf-collection__grid" role="list">
          {%- for product in collection.products -%}
            <li class="nf-collection__item">
              {% render 'nf-product-card',
                product: product,
                show_swatches: section.settings.show_swatches,
                show_quick_add: section.settings.show_quick_add,
                media_ratio: card_ratio,
                media_fit: card_media_fit
              %}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="nf-collection__pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a class="nf-collection__page-link" href="{{ paginate.previous.url }}">Previous</a>
            {%- endif -%}
            <span class="nf-collection__page-status">
              Page {{ paginate.current_page }} of {{ paginate.pages }}
            </span>
            {%- if paginate.next -%}
              <a class="nf-collection__page-link" href="{{ paginate.next.url }}">Next</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="nf-collection__empty">
          <p>{{ section.settings.empty_text | default: 'No products in this collection yet.' | escape }}</p>
          <a class="nf-btn nf-btn--primary" href="{{ routes.all_products_collection_url }}">Browse all</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

