{% render 'bf-section-padding', section: section %}
{% style %}
  /* bf-section-padding-apply */
  #shopify-section-{{ section.id }} .nf-sustain {
    padding-block: var(--bf-pad-top, 0) var(--bf-pad-bottom, 0);
    padding-inline: var(--bf-pad-x, var(--bf-page-pad-x, 0));
  }
{% endstyle %}

<section class="nf-sustain nf-sustain--standalone" id="{{ section.settings.anchor_id | default: 'sustainability' }}">
  <div class="nf-sustain__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="nf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="nf-heading nf-sustain__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="nf-sustain__body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="nf-btn" href="{{ section.settings.cta_url | default: routes.root_url }}" style="margin-top: 1.25rem;">
        {{- section.settings.cta_label | escape -}}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.image != blank or section.settings.video != blank or section.settings.asset != blank -%}
    <div class="nf-sustain__media" style="margin: 2rem 0;">
      {%- render 'nf-media',
        video: section.settings.video,
        image: section.settings.image,
        asset: section.settings.asset,
        alt: section.settings.heading,
        class: 'nf-about__img',
        sizes: '(min-width: 750px) 60vw, 100vw'
      -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="nf-sustain__grid">
      {%- for block in section.blocks -%}
        <li class="nf-sustain__item" {{ block.shopify_attributes }}>
          {%- if block.settings.stat != blank -%}
            <span class="nf-sustain__stat">{{ block.settings.stat | escape }}</span>
          {%- endif -%}
          <h3 class="nf-sustain__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.body != blank -%}
            <div class="nf-sustain__text">{{ block.settings.body }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

