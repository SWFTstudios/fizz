{% render 'bf-section-padding', section: section %}
{% style %}
  /* bf-section-padding-apply */
  #shopify-section-{{ section.id }} .nf-list-collections {
    padding-block: var(--bf-pad-top, 0) var(--bf-pad-bottom, 0);
    padding-inline: var(--bf-pad-x, var(--bf-page-pad-x, 0));
  }
{% endstyle %}

<section class="nf-list-collections">
  <header class="nf-collection__head">
    <p class="nf-eyebrow">{{ section.settings.eyebrow | default: 'Browse' | escape }}</p>
    <h1 class="nf-heading nf-collection__title">{{ section.settings.heading | default: 'Collections' | escape }}</h1>
  </header>

  <div class="nf-collection__grid nf-collection__grid--3">
    {%- for collection in collections -%}
      <article class="nf-card">
        <a href="{{ collection.url }}" class="nf-card__link">
          <div class="nf-card__media nf-card__media--lime">
            <span class="nf-card__wash" aria-hidden="true"></span>
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag: class: 'nf-card__img nf-card__img--ph', loading: 'lazy', sizes: '(min-width: 750px) 33vw, 50vw', widths: '360, 540, 720, 900', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'nf-card__img nf-card__img--ph' }}
            {%- endif -%}
          </div>
          <div class="nf-card__info">
            <h2 class="nf-card__title">{{ collection.title | escape }}</h2>
          </div>
        </a>
      </article>
    {%- endfor -%}
  </div>
</section>

