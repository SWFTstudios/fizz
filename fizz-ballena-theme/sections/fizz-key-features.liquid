{{ 'fizz-key-features.css' | asset_url | stylesheet_tag }}
{% render 'bf-section-padding', section: section %}

{% liquid
  assign frame_count = 121
  assign last_frame = frame_count | minus: 1
  assign poster = section.settings.poster_frame | default: 0
  if poster < 0
    assign poster = 0
  endif
  if poster > last_frame
    assign poster = last_frame
  endif
  assign poster_pad = poster | prepend: '000' | slice: -3, 3
  assign poster_file_mobile = 'fizz-kf-m-' | append: poster_pad | append: '.webp'
  assign poster_file_desktop = 'fizz-kf-d-' | append: poster_pad | append: '.webp'
  assign layout = section.settings.layout | default: 'split'
  assign glass_tint = section.settings.glass_tint | default: '#ffffff'
  assign scroll_vh = section.settings.scroll_track_vh | default: 360
  assign media_vh = section.settings.media_size_vh | default: 72
  if media_vh < 60
    assign media_vh = 60
  endif
  assign media_vh_mobile = section.settings.media_size_vh_mobile | default: 58
  if media_vh_mobile < 45
    assign media_vh_mobile = 45
  endif
  assign cards_pad_x = section.settings.cards_padding_x | default: 16
  assign cards_pad_y = section.settings.cards_padding_y | default: 24
  assign feature_count = section.blocks.size | at_least: 1
  assign base_override = section.settings.sequence_base_url | strip
  assign base_override_mobile = section.settings.sequence_base_url_mobile | strip
  assign base_override_desktop = section.settings.sequence_base_url_desktop | strip
  if base_override != blank
    assign base_last = base_override | slice: -1, 1
    if base_last != '/'
      assign base_override = base_override | append: '/'
    endif
  endif
  if base_override_mobile == blank and base_override != blank
    assign base_override_mobile = base_override
  endif
  if base_override_desktop == blank and base_override != blank
    assign base_override_desktop = base_override
  endif
  if base_override_mobile != blank
    assign base_last = base_override_mobile | slice: -1, 1
    if base_last != '/'
      assign base_override_mobile = base_override_mobile | append: '/'
    endif
  endif
  if base_override_desktop != blank
    assign base_last = base_override_desktop | slice: -1, 1
    if base_last != '/'
      assign base_override_desktop = base_override_desktop | append: '/'
    endif
  endif
  if base_override_mobile != blank
    assign poster_url_mobile = base_override_mobile | append: 'fizz-kf-m-' | append: poster_pad | append: '.webp'
  else
    assign poster_url_mobile = poster_file_mobile | asset_url
  endif
  if base_override_desktop != blank
    assign poster_url_desktop = base_override_desktop | append: 'fizz-kf-d-' | append: poster_pad | append: '.webp'
  else
    assign poster_url_desktop = poster_file_desktop | asset_url
  endif

  assign color_eyebrow = section.settings.color_eyebrow | default: '#1a1f1c'
  assign color_heading = section.settings.color_heading | default: '#0e1412'
  assign color_subheading = section.settings.color_subheading | default: '#3a423e'
  assign color_card_tag = section.settings.color_card_tag | default: '#1a1f1c'
  assign color_card_title = section.settings.color_card_title | default: '#0e1412'
  assign color_card_body = section.settings.color_card_body | default: '#3a423e'

  assign use_theme_spacing = section.settings.use_theme_spacing
  if use_theme_spacing == nil
    assign use_theme_spacing = false
  endif

  unless use_theme_spacing
    assign vertical = section.settings.padding_vertical | default: 'flush'
    case vertical
      when 'flush'
        assign pad_top = '0'
        assign pad_bottom = '0'
      when 'compact'
        assign pad_top = '2rem'
        assign pad_bottom = '2rem'
      when 'default'
        assign pad_top = '4rem'
        assign pad_bottom = '4rem'
      when 'relaxed'
        assign pad_top = '6rem'
        assign pad_bottom = '6rem'
      when 'statement'
        assign pad_top = '8rem'
        assign pad_bottom = '8rem'
      when 'hero'
        assign pad_top = '0'
        assign pad_bottom = '0'
      when 'custom'
        assign pad_top = section.settings.padding_top | default: 0 | append: 'px'
        assign pad_bottom = section.settings.padding_bottom | default: 0 | append: 'px'
      else
        assign pad_top = '0'
        assign pad_bottom = '0'
    endcase

    assign horizontal = section.settings.padding_horizontal | default: 'full'
    case horizontal
      when 'none'
        assign pad_left = '0'
        assign pad_right = '0'
      when 'full'
        assign pad_left = '0'
        assign pad_right = '0'
      when 'custom'
        assign pad_left = section.settings.padding_left | default: 0 | append: 'px'
        assign pad_right = section.settings.padding_right | default: 0 | append: 'px'
      else
        assign pad_left = 'clamp(1rem, 4vw, 2.5rem)'
        assign pad_right = 'clamp(1rem, 4vw, 2.5rem)'
    endcase
  endunless

  assign bg_media_opacity = section.settings.background_media_opacity | default: 100 | times: 1.0 | divided_by: 100.0
  assign bg_blur = section.settings.background_blur | default: 0
  assign has_bg_image = false
  if section.settings.background_image != blank
    assign has_bg_image = true
  endif
  assign has_bg_video = false
  if section.settings.background_video != blank or section.settings.background_video_url != blank
    assign has_bg_video = true
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    {%- if use_theme_spacing -%}
      padding-block: var(--bf-pad-top) var(--bf-pad-bottom);
      padding-inline: var(--bf-pad-x);
    {%- else -%}
      padding-top: {{ pad_top }};
      padding-bottom: {{ pad_bottom }};
      padding-left: {{ pad_left }};
      padding-right: {{ pad_right }};
    {%- endif -%}
    {%- if section.settings.background_color != blank -%}
    background-color: {{ section.settings.background_color }};
    {%- endif -%}
    position: relative;
    z-index: 1;
  }
{% endstyle %}

{% capture frame_manifest_mobile %}
[
{%- for i in (0..49) -%}
  {%- assign pad = i | prepend: '000' | slice: -3, 3 -%}
  {%- if base_override_mobile != blank -%}
    {%- assign frame_url = base_override_mobile | append: 'fizz-kf-m-' | append: pad | append: '.webp' -%}
  {%- else -%}
    {%- assign fname = 'fizz-kf-m-' | append: pad | append: '.webp' -%}
    {%- assign frame_url = fname | asset_url -%}
  {%- endif -%}
  {{ frame_url | json }},
{%- endfor -%}
{%- for i in (50..99) -%}
  {%- assign pad = i | prepend: '000' | slice: -3, 3 -%}
  {%- if base_override_mobile != blank -%}
    {%- assign frame_url = base_override_mobile | append: 'fizz-kf-m-' | append: pad | append: '.webp' -%}
  {%- else -%}
    {%- assign fname = 'fizz-kf-m-' | append: pad | append: '.webp' -%}
    {%- assign frame_url = fname | asset_url -%}
  {%- endif -%}
  {{ frame_url | json }},
{%- endfor -%}
{%- for i in (100..120) -%}
  {%- assign pad = i | prepend: '000' | slice: -3, 3 -%}
  {%- if base_override_mobile != blank -%}
    {%- assign frame_url = base_override_mobile | append: 'fizz-kf-m-' | append: pad | append: '.webp' -%}
  {%- else -%}
    {%- assign fname = 'fizz-kf-m-' | append: pad | append: '.webp' -%}
    {%- assign frame_url = fname | asset_url -%}
  {%- endif -%}
  {{ frame_url | json }}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{% endcapture %}

{% capture frame_manifest_desktop %}
[
{%- for i in (0..49) -%}
  {%- assign pad = i | prepend: '000' | slice: -3, 3 -%}
  {%- if base_override_desktop != blank -%}
    {%- assign frame_url = base_override_desktop | append: 'fizz-kf-d-' | append: pad | append: '.webp' -%}
  {%- else -%}
    {%- assign fname = 'fizz-kf-d-' | append: pad | append: '.webp' -%}
    {%- assign frame_url = fname | asset_url -%}
  {%- endif -%}
  {{ frame_url | json }},
{%- endfor -%}
{%- for i in (50..99) -%}
  {%- assign pad = i | prepend: '000' | slice: -3, 3 -%}
  {%- if base_override_desktop != blank -%}
    {%- assign frame_url = base_override_desktop | append: 'fizz-kf-d-' | append: pad | append: '.webp' -%}
  {%- else -%}
    {%- assign fname = 'fizz-kf-d-' | append: pad | append: '.webp' -%}
    {%- assign frame_url = fname | asset_url -%}
  {%- endif -%}
