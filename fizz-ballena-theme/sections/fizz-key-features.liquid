]
{% endcapture %}

<section
  class="fizz-key-features fizz-key-features--cards-{{ layout }}"
  id="{{ section.settings.anchor_id | default: 'features' | handle }}"
  data-fizz-key-features
  data-fkf-mode="desktop"
  data-frame-count="{{ frame_count }}"
  data-feature-count="{{ feature_count }}"
  data-poster-frame="{{ poster }}"
  style="
    --fkf-scroll-vh: {{ scroll_vh }};
    --fkf-media-h-desktop: {{ media_vh }}dvh;
    --fkf-media-h-mobile: {{ media_vh_mobile }}dvh;
    --fkf-media-h: {{ media_vh }}dvh;
    --fkf-aspect: 1600 / 1280;
    --fkf-glass-tint: {{ glass_tint }};
    --fkf-features: {{ feature_count }};
    --fkf-cards-pad-x: {{ cards_pad_x }}px;
    --fkf-cards-pad-y: {{ cards_pad_y }}px;
    --fkf-eyebrow: {{ color_eyebrow }};
    --fkf-heading: {{ color_heading }};
    --fkf-sub: {{ color_subheading }};
    --fkf-card-tag: {{ color_card_tag }};
    --fkf-card-title: {{ color_card_title }};
    --fkf-card-body: {{ color_card_body }};
    --fkf-bg-opacity: {{ bg_media_opacity }};
    --fkf-bg-blur: {{ bg_blur }}px;
  "
>
  <div class="fizz-key-features__track" data-fkf-track style="height: {{ scroll_vh }}vh;">
    <div class="fizz-key-features__sticky" data-fkf-sticky>
      {%- if has_bg_image or has_bg_video -%}
        <div class="fizz-key-features__bg" aria-hidden="true">
          {%- if has_bg_image -%}
            <div class="fizz-key-features__bg-image">
              {{
                section.settings.background_image
                | image_url: width: 2880
                | image_tag:
                  class: 'fizz-key-features__bg-media',
                  loading: 'lazy',
                  sizes: '100vw',
                  widths: '720, 1080, 1440, 1920, 2880',
                  alt: ''
              }}
            </div>
          {%- endif -%}
          {%- if has_bg_video -%}
            <div class="fizz-key-features__bg-video">
              {%- render 'nf-media',
                video: section.settings.background_video,
                video_url: section.settings.background_video_url,
                class: 'fizz-key-features__bg-media',
                alt: '',
                loading: 'lazy',
                sizes: '100vw',
                autoplay: true
              -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <header class="fizz-key-features__head">
        {% if section.settings.eyebrow != blank %}
          <p class="fizz-key-features__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="fizz-key-features__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="fizz-key-features__sub">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </header>

      <div class="fizz-key-features__shell">
        <div class="fizz-key-features__stage" data-fkf-stage>
          <canvas class="fizz-key-features__canvas" data-fkf-canvas width="1600" height="1280" aria-hidden="true"></canvas>
          <img
            class="fizz-key-features__poster"
            data-fkf-poster
            data-poster-mobile="{{ poster_url_mobile | escape }}"
            data-poster-desktop="{{ poster_url_desktop | escape }}"
            src="{{ poster_url_desktop | escape }}"
            alt=""
            width="1600"
            height="1280"
            decoding="async"
          >
        </div>

        <div class="fizz-key-features__cards-layer" data-fkf-cards-layer role="list">
          {% for block in section.blocks %}
            {% liquid
              assign fs = block.settings.frame_start
              assign fe = block.settings.frame_end
              if fs == blank or fe == blank
                assign slice = last_frame | plus: 1 | divided_by: feature_count
                assign fs = forloop.index0 | times: slice
                if forloop.last
                  assign fe = last_frame
                else
                  assign fe = forloop.index | times: slice | minus: 1
                endif
              endif

              assign dx = block.settings.desktop_x
              assign dy = block.settings.desktop_y
              if dx == blank
                assign mod = forloop.index0 | modulo: 2
                if mod == 0
                  assign dx = 6
                else
                  assign dx = 70
                endif
              endif
              if dy == blank
                case forloop.index0
                  when 0
                    assign dy = 58
                  when 1
                    assign dy = 52
                  when 2
                    assign dy = 72
                  else
                    assign dy = 68
                endcase
              endif

              assign side = block.settings.rail_side | default: 'left'
              if layout == 'split'
                if block.settings.rail_side == blank
                  assign mod = forloop.index0 | modulo: 2
                  if mod == 0
                    assign side = 'left'
                  else
                    assign side = 'right'
                  endif
                endif
              elsif layout == 'right'
                assign side = 'right'
              elsif layout == 'left'
                assign side = 'left'
              endif
            %}
            <article
              class="fizz-key-features__card"
              data-fkf-card
              data-index="{{ forloop.index0 }}"
              data-frame-start="{{ fs }}"
              data-frame-end="{{ fe }}"
              data-side="{{ side }}"
              role="listitem"
              tabindex="0"
              style="--fkf-card-x: {{ dx }}%; --fkf-card-y: {{ dy }}%;"
              {{ block.shopify_attributes }}
            >
              <div class="fizz-key-features__card-top">
                {% if block.settings.tag != blank %}
                  <span class="fizz-key-features__tag">{{ block.settings.tag | escape }}</span>
                {% endif %}
                <span class="fizz-key-features__num" aria-hidden="true">
                  {{ forloop.index | prepend: '0' | slice: -2, 2 }}
                </span>
              </div>
              {% if block.settings.title != blank %}
                <h3 class="fizz-key-features__title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.body != blank %}
                <div class="fizz-key-features__body">{{ block.settings.body }}</div>
              {% endif %}
              {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                <a class="fizz-key-features__cta" href="{{ block.settings.button_link }}">
                  {{ block.settings.button_label | escape }}
                </a>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-fkf-frames-mobile>
    {{ frame_manifest_mobile | strip }}
  </script>
  <script type="application/json" data-fkf-frames-desktop>
    {{ frame_manifest_desktop | strip }}
  </script>
</section>

<script src="{{ 'fizz-key-features.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Fizz Key Features",
  "tag": "section",
  "class": "fizz-key-features-section",
  "settings": [
    { "type": "header", "content": "Section spacing" },
    {
      "type": "checkbox",
      "id": "use_theme_spacing",
      "label": "Use global padding",
      "info": "Uses Theme settings → Layout for desktop and mobile padding. Turn off to use the spacing controls below.",
      "default": false
    },
    {
      "type": "select",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "options": [
        { "value": "flush", "label": "None" },
        { "value": "compact", "label": "Compact" },
        { "value": "default", "label": "Default" },
        { "value": "relaxed", "label": "Relaxed" },
        { "value": "statement", "label": "Statement" },
        { "value": "hero", "label": "Hero band" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "flush",
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top (custom)",
      "default": 0,
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (custom)",
      "default": 0,
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "select",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "full", "label": "Full width" },
        { "value": "none", "label": "None" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "full",
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding left (custom)",
      "default": 0,
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding right (custom)",
      "default": 0,
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "select",
      "id": "padding_x",
      "label": "Horizontal padding (desktop)",
      "info": "Used when Use global padding is on via the padding snippet overrides.",
      "options": [
        { "value": "16px", "label": "16px", "group": "Pixels" },
        { "value": "20px", "label": "20px", "group": "Pixels" },
        { "value": "24px", "label": "24px", "group": "Pixels" },
        { "value": "32px", "label": "32px", "group": "Pixels" },
        { "value": "40px", "label": "40px", "group": "Pixels" },
        { "value": "48px", "label": "48px", "group": "Pixels" },
        { "value": "64px", "label": "64px", "group": "Pixels" },
        { "value": "1rem", "label": "1rem", "group": "Rem" },
        { "value": "1.5rem", "label": "1.5rem", "group": "Rem" },
        { "value": "2rem", "label": "2rem", "group": "Rem" },
        { "value": "2.5rem", "label": "2.5rem", "group": "Rem" },
        { "value": "3rem", "label": "3rem", "group": "Rem" },
        { "value": "4%", "label": "4%", "group": "Percent" },
        { "value": "5%", "label": "5%", "group": "Percent" },
        { "value": "6%", "label": "6%", "group": "Percent" },
        { "value": "8%", "label": "8%", "group": "Percent" },
        { "value": "10%", "label": "10%", "group": "Percent" },
        { "value": "0", "label": "Full width", "group": "Full width" }
      ],
      "default": "0",
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "select",
      "id": "padding_x_mobile",
      "label": "Horizontal padding (mobile)",
      "options": [
        { "value": "16px", "label": "16px", "group": "Pixels" },
        { "value": "20px", "label": "20px", "group": "Pixels" },
        { "value": "24px", "label": "24px", "group": "Pixels" },
        { "value": "32px", "label": "32px", "group": "Pixels" },
        { "value": "40px", "label": "40px", "group": "Pixels" },
        { "value": "48px", "label": "48px", "group": "Pixels" },
        { "value": "64px", "label": "64px", "group": "Pixels" },
        { "value": "1rem", "label": "1rem", "group": "Rem" },
        { "value": "1.5rem", "label": "1.5rem", "group": "Rem" },
        { "value": "2rem", "label": "2rem", "group": "Rem" },
        { "value": "2.5rem", "label": "2.5rem", "group": "Rem" },
        { "value": "3rem", "label": "3rem", "group": "Rem" },
        { "value": "4%", "label": "4%", "group": "Percent" },
        { "value": "5%", "label": "5%", "group": "Percent" },
        { "value": "6%", "label": "6%", "group": "Percent" },
        { "value": "8%", "label": "8%", "group": "Percent" },
        { "value": "10%", "label": "10%", "group": "Percent" },
        { "value": "0", "label": "Full width", "group": "Full width" }
      ],
      "default": "0",
      "visible_if": "{{ section.settings.use_theme_spacing == false }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#c5d4e0"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Shopify Files MP4. Autoplay is muted and looped."
    },
    {
      "type": "video_url",
      "id": "background_video_url",
      "label": "Background video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Used when no Shopify-hosted video is set."
    },
    {
      "type": "range",
      "id": "background_media_opacity",
      "label": "Background media opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "background_blur",
      "label": "Background blur radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Key features"
