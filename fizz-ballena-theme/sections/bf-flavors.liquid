{{ 'bf-flavors.css' | asset_url | stylesheet_tag }}
<section
  class="bf-section bf-flavors"
  id="{{ section.settings.anchor_id | default: 'flavors' | handle }}"
>
  {% render 'bf-section-chrome', section: section %}

  <div class="bf-section__inner">
    <div class="bf-flavors__intro">
      <div class="bf-flavors__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="bf-section__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bf-section__body">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      <div class="bf-flavors__video">
        {%- render 'nf-media',
          video: section.settings.feature_video,
          video_url: section.settings.feature_video_url,
          image: section.settings.feature_image,
          asset: section.settings.feature_asset,
          alt: section.settings.heading,
          class: 'bf-flavors__video-media',
          sizes: '(min-width: 900px) 45vw, 100vw',
          loading: 'lazy',
          autoplay: true
        -%}
      </div>
    </div>

    <div class="bf-flavors__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'flavor' -%}
          <article class="bf-flavors__card" {{ block.shopify_attributes }}>
            <div class="bf-flavors__card-media">
              {%- render 'nf-media',
                image: block.settings.image,
                asset: block.settings.asset,
                alt: block.settings.title,
                class: 'bf-flavors__card-img',
                sizes: '(min-width: 900px) 28vw, 80vw',
                loading: 'lazy'
              -%}
            </div>
            <h3 class="bf-flavors__card-title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.body != blank -%}
              <p>{{ block.settings.body | escape }}</p>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BF Flavors",
  "tag": "section",
  "class": "bf-flavors-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "flavors"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Intro to flavors"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Headline + video animation."
    },
    {
      "type": "video",
      "id": "feature_video",
      "label": "Feature video"
    },
    {
      "type": "video_url",
      "id": "feature_video_url",
      "label": "Feature video URL",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Feature image"
    },
    {
      "type": "text",
      "id": "feature_asset",
      "label": "Feature asset fallback",
      "default": "nf-lifestyle-hero-04.jpg"
    },
    {
      "type": "header",
      "content": "Section chrome \u2014 spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section chrome \u2014 typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 16,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "body_font_weight",
      "label": "Body font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0e1412"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#3a423e"
    },
    {
      "type": "header",
      "content": "Section chrome \u2014 background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f7f5f0"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Shopify Files MP4. Autoplay is muted and looped."
    },
    {
      "type": "video_url",
      "id": "background_video_url",
      "label": "Background video URL",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "Used when no Shopify-hosted video is set."
    },
    {
      "type": "range",
      "id": "background_image_opacity",
      "label": "Background image opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "background_video_opacity",
      "label": "Background video opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Flavor"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Theme asset fallback",
          "default": "nf-lifestyle-hero-02.jpg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BF Flavors",
      "blocks": [
        {
          "type": "flavor",
          "settings": {
            "title": "Citrus",
            "asset": "nf-lifestyle-hero-02.jpg"
          }
        },
        {
          "type": "flavor",
          "settings": {
            "title": "Berry",
            "asset": "nf-lifestyle-hero-03.jpg"
          }
        },
        {
          "type": "flavor",
          "settings": {
            "title": "Classic",
            "asset": "nf-lifestyle-hero-05.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
