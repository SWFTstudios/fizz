{% render 'bf-section-padding', section: section %}
{%- assign step_count = section.blocks.size | at_least: 1 -%}
<section
  class="nf-how"
  id="{{ section.settings.anchor_id | default: 'how' }}"
  data-nf-how
  style="--how-steps: {{ step_count }};"
>
  <div class="nf-how__track" data-nf-how-track>
    <div class="nf-how__sticky">
      <div class="nf-how__stage">
        {%- for block in section.blocks -%}
          <figure
            class="nf-how__layer{% if forloop.first %} is-active{% endif %}"
            data-nf-how-layer
            {{ block.shopify_attributes }}
          >
            {%- render 'nf-media',
              video: block.settings.video,
              image: block.settings.image,
              asset: block.settings.asset,
              alt: block.settings.title,
              class: 'nf-how__img',
              sizes: '(min-width: 750px) 55vw, 100vw'
            -%}
          </figure>
        {%- endfor -%}
        <div class="nf-how__stage-meta">
          <span class="nf-how__counter" data-nf-how-counter>01 / {{ step_count | prepend: '0' | slice: -2, 2 }}</span>
          <span class="nf-how__progress" aria-hidden="true"><span class="nf-how__progress-fill"></span></span>
        </div>
      </div>

      <div class="nf-how__panel">
        <div class="nf-how__head">
          {%- if section.settings.eyebrow != blank -%}
            <p class="nf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="nf-heading nf-how__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
        <ol class="nf-how__steps">
          {%- for block in section.blocks -%}
            <li
              class="nf-how__step{% if forloop.first %} is-active{% endif %}"
              data-nf-how-step
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="nf-how__step-trigger"
                data-nf-how-goto
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Go to step {{ forloop.index }}: {{ block.settings.title | escape }}"
              >
                <span class="nf-how__step-num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="nf-how__step-title">{{ block.settings.title | escape }}</span>
              </button>
              {%- if block.settings.body != blank -%}
                <div class="nf-how__step-body">{{ block.settings.body }}</div>
              {%- endif -%}
              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                {% render 'nf-button',
                  label: block.settings.button_label,
                  url: block.settings.button_link,
                  style: block.settings.button_style,
                  class: 'nf-btn--pill nf-how__step-cta'
                %}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </div>
</section>

