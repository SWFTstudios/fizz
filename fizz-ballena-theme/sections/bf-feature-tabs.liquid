{{ 'bf-feature-tabs.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_height = section.settings.section_height | default: 100
-%}
<section
  class="bf-section bf-tabs"
  id="{{ section.settings.anchor_id | default: 'how' | handle }}"
  data-bf-tabs
  data-autoplay="{{ section.settings.autoplay_seconds | default: 5 }}"
  data-autoplay-enabled="{% if section.settings.autoplay %}true{% else %}false{% endif %}"
  style="--bf-tabs-outline: {{ section.settings.active_outline | default: '#6b9fd4' }}; --bf-tabs-height: {{ section_height }}dvh;"
>
  {% render 'bf-section-chrome', section: section %}

  <div class="bf-tabs__grid">
    <div class="bf-tabs__panel">
      <div class="bf-tabs__labels" role="tablist" aria-label="{{ section.settings.heading | default: 'Features' | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            <button
              type="button"
              class="bf-tabs__label{% if forloop.first %} is-active{% endif %}"
              role="tab"
              id="bf-tab-{{ section.id }}-{{ forloop.index0 }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="bf-tabpanel-{{ section.id }}-{{ forloop.index0 }}"
              data-bf-tab
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <span class="bf-tabs__label-text">{{ block.settings.title | escape }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="bf-tabs__copy">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            <div
              class="bf-tabs__desc{% if forloop.first %} is-active{% endif %}"
              role="tabpanel"
              id="bf-tabpanel-{{ section.id }}-{{ forloop.index0 }}"
              aria-labelledby="bf-tab-{{ section.id }}-{{ forloop.index0 }}"
              data-bf-tab-desc
              data-index="{{ forloop.index0 }}"
            >
              {%- if block.settings.body != blank -%}
                <p>{{ block.settings.body | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="bf-tabs__media" aria-live="polite">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          <figure
            class="bf-tabs__figure{% if forloop.first %} is-active{% endif %}"
            data-bf-tab-media
            data-index="{{ forloop.index0 }}"
          >
            {%- render 'nf-media',
              video: block.settings.video,
              image: block.settings.image,
              asset: block.settings.asset,
              alt: block.settings.title,
              class: 'bf-tabs__img',
              sizes: '(min-width: 900px) 50vw, 100vw',
              loading: 'lazy'
            -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="{{ 'bf-feature-tabs.js' | asset_url }}" defer></script>

