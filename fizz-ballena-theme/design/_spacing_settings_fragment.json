[
  {
    "type": "header",
    "content": "Section chrome — spacing"
  },
  {
    "type": "checkbox",
    "id": "use_theme_spacing",
    "label": "Use global padding",
    "info": "Uses Theme settings → Layout for desktop and mobile padding. Turn off to set unique padding below.",
    "default": true
  },
  {
    "type": "range",
    "id": "padding_top",
    "label": "Padding top (desktop)",
    "min": 0,
    "max": 200,
    "step": 4,
    "unit": "px",
    "default": 80,
    "visible_if": "{{ section.settings.use_theme_spacing == false }}"
  },
  {
    "type": "range",
    "id": "padding_bottom",
    "label": "Padding bottom (desktop)",
    "min": 0,
    "max": 200,
    "step": 4,
    "unit": "px",
    "default": 80,
    "visible_if": "{{ section.settings.use_theme_spacing == false }}"
  },
  {
    "type": "range",
    "id": "padding_top_mobile",
    "label": "Padding top (mobile)",
    "min": 0,
    "max": 200,
    "step": 4,
    "unit": "px",
    "default": 48,
    "visible_if": "{{ section.settings.use_theme_spacing == false }}"
  },
  {
    "type": "range",
    "id": "padding_bottom_mobile",
    "label": "Padding bottom (mobile)",
    "min": 0,
    "max": 200,
    "step": 4,
    "unit": "px",
    "default": 48,
    "visible_if": "{{ section.settings.use_theme_spacing == false }}"
  },
  {
    "type": "select",
    "id": "padding_x",
    "label": "Horizontal padding (desktop)",
    "info": "Side inset at 750px+. Full width = edge to edge.",
    "options": [
      { "value": "16px", "label": "16px", "group": "Pixels" },
      { "value": "20px", "label": "20px", "group": "Pixels" },
      { "value": "24px", "label": "24px", "group": "Pixels" },
      { "value": "32px", "label": "32px", "group": "Pixels" },
      { "value": "40px", "label": "40px", "group": "Pixels" },
      { "value": "48px", "label": "48px", "group": "Pixels" },
      { "value": "64px", "label": "64px", "group": "Pixels" },
      { "value": "1rem", "label": "1rem", "group": "Rem" },
      { "value": "1.5rem", "label": "1.5rem", "group": "Rem" },
      { "value": "2rem", "label": "2rem", "group": "Rem" },
      { "value": "2.5rem", "label": "2.5rem", "group": "Rem" },
      { "value": "3rem", "label": "3rem", "group": "Rem" },
      { "value": "4%", "label": "4%", "group": "Percent" },
      { "value": "5%", "label": "5%", "group": "Percent" },
      { "value": "6%", "label": "6%", "group": "Percent" },
      { "value": "8%", "label": "8%", "group": "Percent" },
      { "value": "10%", "label": "10%", "group": "Percent" },
      { "value": "0", "label": "Full width", "group": "Full width" }
    ],
    "default": "5%",
    "visible_if": "{{ section.settings.use_theme_spacing == false }}"
  },
  {
    "type": "select",
    "id": "padding_x_mobile",
    "label": "Horizontal padding (mobile)",
    "info": "Side inset below 750px. Full width = edge to edge.",
    "options": [
      { "value": "16px", "label": "16px", "group": "Pixels" },
      { "value": "20px", "label": "20px", "group": "Pixels" },
      { "value": "24px", "label": "24px", "group": "Pixels" },
      { "value": "32px", "label": "32px", "group": "Pixels" },
      { "value": "40px", "label": "40px", "group": "Pixels" },
      { "value": "48px", "label": "48px", "group": "Pixels" },
      { "value": "64px", "label": "64px", "group": "Pixels" },
      { "value": "1rem", "label": "1rem", "group": "Rem" },
      { "value": "1.5rem", "label": "1.5rem", "group": "Rem" },
      { "value": "2rem", "label": "2rem", "group": "Rem" },
      { "value": "2.5rem", "label": "2.5rem", "group": "Rem" },
      { "value": "3rem", "label": "3rem", "group": "Rem" },
      { "value": "4%", "label": "4%", "group": "Percent" },
      { "value": "5%", "label": "5%", "group": "Percent" },
      { "value": "6%", "label": "6%", "group": "Percent" },
      { "value": "8%", "label": "8%", "group": "Percent" },
      { "value": "10%", "label": "10%", "group": "Percent" },
      { "value": "0", "label": "Full width", "group": "Full width" }
    ],
    "default": "16px",
    "visible_if": "{{ section.settings.use_theme_spacing == false }}"
  },
  {
    "type": "range",
    "id": "margin_top",
    "label": "Margin top",
    "min": 0,
    "max": 160,
    "step": 4,
    "unit": "px",
    "default": 0
  },
  {
    "type": "range",
    "id": "margin_bottom",
    "label": "Margin bottom",
    "min": 0,
    "max": 160,
    "step": 4,
    "unit": "px",
    "default": 0
  }
]
